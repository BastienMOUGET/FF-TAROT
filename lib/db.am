namespace App

import Amalgame.Database.MySQL

// Couche d'accès MariaDB. amc n'a PAS de champ statique mutable, donc le
// handle vit dans une INSTANCE Db créée dans Main et capturée par les
// closures de route (passée à chaque handler en paramètre).
// Le driver est mono-owner → serveur mono-thread (WebApp.Serve).
// Toutes les cellules SQL sont des `string` ; NULL → "".
public class Db {

    public Conn: AmalgameMySQL
    public Io:   SocketIO       // injecté dans Main ; sert au broadcast classement
    public Db() {}

    // Ouvre la connexion depuis l'environnement. true si OK.
    public bool Open() {
        let host: string = Config.Get("DB_HOST", "127.0.0.1")
        let portS: string = Config.Get("DB_PORT", "3306")
        let user: string = Config.Get("DB_USER", "fft_user")
        let pass: string = Config.Get("DB_PASSWORD", "")
        let name: string = Config.Get("DB_NAME", "fft")
        var port: int = 3306
        if (String.Length(portS) > 0) { port = String.ToInt(portS) }

        this.Conn = MySQL.Open(host, port, user, pass, name)
        return MySQL.IsOpen(this.Conn)
    }

    // ── Reconnexion ──────────────────────────────────────
    // La connexion est ouverte une fois au démarrage et vit ensuite
    // aussi longtemps que le processus. Deux cas la rendent morte sans
    // que le serveur s'en aperçoive :
    //   - MariaDB ferme toute connexion inactive depuis wait_timeout
    //     (8 h par défaut) : le lendemain matin, chaque requête échoue ;
    //   - au boot Windows, le service démarre avant MariaDB : Open()
    //     échoue et le handle reste vide pour toujours.
    // Symptôme identique dans les deux cas : Rows() rend une liste vide,
    // le login répond « Identifiants invalides » à tout le monde, et
    // seul un redémarrage du service (ou une réinstallation) débloque.
    // Retour terrain du 2026-09-06 : c'est exactement ce qui est arrivé.
    //
    // Correctif : quand une requête échoue sur une erreur de connexion,
    // on rouvre et on rejoue la requête une fois. Sans coût quand tout
    // va bien (aucune requête de sonde supplémentaire).

    // Erreurs libmariadb qui signifient « la connexion n'est plus là »,
    // et non « la requête est fausse » : 2003 Can't connect, 2006 gone
    // away, 2013 Lost connection, ou handle jamais ouvert.
    static bool IsConnLost(string err) {
        if (String.Contains(err, "gone away")) { return true }
        if (String.Contains(err, "Lost connection")) { return true }
        if (String.Contains(err, "Can't connect")) { return true }
        if (String.Contains(err, "connection not open")) { return true }
        return false
    }

    // Rouvre si la dernière erreur est une perte de connexion. true si
    // la requête mérite d'être rejouée.
    bool Reconnect() {
        if (!Db.IsConnLost(MySQL.LastError(this.Conn))) { return false }
        MySQL.Close(this.Conn)
        let ok: bool = this.Open()
        if (ok) { Console.WriteLine("DB: reconnecté") }
        else { Console.WriteError("DB: reconnexion impossible — " + this.LastError()) }
        return ok
    }

    // La ligne existe-t-elle ? Sert aux UPDATE : mysql_affected_rows vaut 0
    // quand la ligne existe mais n'a pas changé (mêmes valeurs), ce qu'on
    // prenait pour un « introuvable » (retour terrain n°6 : enregistrer un
    // club sans rien modifier répondait 404).
    public bool ExistsById(string table, string id) {
        let rows: List<List<string>> = this.Rows("SELECT 1 FROM " + table + " WHERE id = ? LIMIT 1", Db.P1(id))
        return rows.Count() > 0
    }

    public string LastError() { return MySQL.LastError(this.Conn) }
    public int LastInsertId() { return MySQL.LastInsertId(this.Conn) }
    public int Changes() { return MySQL.Changes(this.Conn) }

    // SELECT paramétré → lignes (List<List<string>>).
    // Une liste vide est aussi un résultat légitime : on ne rejoue que si
    // la dernière erreur enregistrée est une perte de connexion.
    public List<List<string>> Rows(string sql, List<string> params) {
        let rows: List<List<string>> = MySQL.QueryBindAll(this.Conn, sql, params)
        if (rows.Count() > 0) { return rows }
        if (!this.Reconnect()) { return rows }
        return MySQL.QueryBindAll(this.Conn, sql, params)
    }

    // INSERT/UPDATE/DELETE paramétré → true si OK.
    public bool Exec(string sql, List<string> params) {
        if (MySQL.ExecBind(this.Conn, sql, params)) { return true }
        if (!this.Reconnect()) { return false }
        return MySQL.ExecBind(this.Conn, sql, params)
    }

    // DDL / commandes sans paramètres.
    public bool ExecRaw(string sql) {
        if (MySQL.Exec(this.Conn, sql)) { return true }
        if (!this.Reconnect()) { return false }
        return MySQL.Exec(this.Conn, sql)
    }

    // ── Transactions ─────────────────────────────────────
    // Begin est le premier ordre d'une transaction : rejouable. Commit et
    // Rollback ne le sont pas (une connexion perdue en cours de
    // transaction l'a déjà annulée côté serveur).
    public bool Begin() {
        if (MySQL.Begin(this.Conn)) { return true }
        if (!this.Reconnect()) { return false }
        return MySQL.Begin(this.Conn)
    }
    public bool Commit() { return MySQL.Commit(this.Conn) }
    public bool Rollback() { return MySQL.Rollback(this.Conn) }

    // ── Coercions de cellules (NULL = "") — statiques ────
    public static bool IsNull(string cell) { return String.Length(cell) == 0 }

    public static int CellInt(string cell) {
        if (String.Length(cell) == 0) { return 0 }
        return String.ToInt(cell)
    }

    public static float CellFloat(string cell) {
        if (String.Length(cell) == 0) { return 0.0 }
        return String.ToFloat(cell)
    }

    // MariaDB rend les booléens en "0"/"1".
    public static bool CellBool(string cell) { return cell == "1" }

    // ── Construction de listes de paramètres ─────────────
    public static List<string> NoParams() { return new List<string>() }

    public static List<string> P1(string a) {
        let l: List<string> = new List<string>()
        l.Add(a)
        return l
    }

    public static List<string> P2(string a, string b) {
        let l: List<string> = new List<string>()
        l.Add(a)
        l.Add(b)
        return l
    }

    public static List<string> P3(string a, string b, string c) {
        let l: List<string> = new List<string>()
        l.Add(a)
        l.Add(b)
        l.Add(c)
        return l
    }
}
