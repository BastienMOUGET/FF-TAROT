namespace App

import Amalgame.Random

// Portage de src/utils/placement.js — placement Libre par 4 (pur).
// Round 1 : une équipe par table (tables tirées au sort), 4 joueurs N/S/E/O
// dans l'ordre player_number. Rounds N+1 : offset par siège, wrap modulo nbTables.

public class TeamPlayerIn {
    public PlayerId:     int
    public PlayerNumber: int
    public Seat:         string   // "" = non précisé
    public TeamPlayerIn() {}
}

public class TeamIn {
    public Id:      int
    public Players: List<TeamPlayerIn>
    public TeamIn() {}
}

public class SeatRow {
    public TableNumber: int
    public Seat:        string
    public PlayerId:    int
    public TeamId:      int
    public SeatRow() {}
}

public class Placement {

    // Siège par index 0..3 → N/S/E/O.
    public static string SeatAt(int idx) {
        if (idx == 0) { return "N" }
        if (idx == 1) { return "S" }
        if (idx == 2) { return "E" }
        return "O"
    }

    // Entier uniforme dans [0, n) via CSPRNG (4 octets système).
    public static int Below(int n) {
        if (n <= 1) { return 0 }
        let b: List<int> = Random.SystemBytes(4)
        var v: int = 0
        for x in b { v = v * 256 + x }
        if (v < 0) { v = 0 - v }
        return v % n
    }

    // wrapTable(current, offset, nbTables) = ((current-1+offset) mod nb + nb) mod nb + 1
    public static int WrapTable(int currentTable, int offset, int nbTables) {
        if (nbTables <= 0) { return currentTable }
        let idx: int = ((currentTable - 1 + offset) % nbTables + nbTables) % nbTables
        return idx + 1
    }

    // Places du round 1 : tables tirées au sort, 4 joueurs N/S/E/O.
    // `relaisIds` : joueurs virtuels « Relais 1/2/3 » posés en Nord des
    // tables de 3, dans l'ordre (retour terrain n°4 : Nord est fixe toute
    // la soirée et marque des points comme les autres).
    //
    // Les tables de 3 reçoivent des numéros ESPACÉS : leur Relais étant fixe,
    // elles gardent leur numéro toute la soirée, et si elles se suivent
    // (8, 9, 10) un joueur qui avance d'une table les enchaîne trois manches
    // d'affilée (retour terrain n°13).
    public static List<SeatRow> GenerateInitialSeats(List<TeamIn> teams, List<int> relaisIds) {
        let nb: int = teams.Count()
        var nbThrees: int = 0
        for t in teams { if (t.Players.Count() == 3) { nbThrees = nbThrees + 1 } }

        // Numéros réservés aux tables de 3, répartis sur tout le tournoi.
        let threeTables: List<int> = new List<int>()
        if (nbThrees > 0) {
            for k in 0..nbThrees {
                var n: int = ((2 * k + 1) * nb) / (2 * nbThrees) + 1
                if (n < 1) { n = 1 }
                if (n > nb) { n = nb }
                var taken: bool = false
                for x in threeTables { if (x == n) { taken = true } }
                // Décale si la place est déjà prise (petits effectifs).
                while (taken && n <= nb) {
                    n = n + 1
                    taken = false
                    for x in threeTables { if (x == n) { taken = true } }
                }
                if (n <= nb) { threeTables.Add(n) }
            }
        }

        // Les autres numéros vont aux tables de 4, dans un ordre tiré au sort.
        let fourPool: List<int> = new List<int>()
        for i in 0..nb {
            let n: int = i + 1
            var reserved: bool = false
            for x in threeTables { if (x == n) { reserved = true } }
            if (!reserved) { fourPool.Add(n) }
        }
        let fourTables: List<int> = Placement.Shuffled(fourPool)
        let threeShuffled: List<int> = Placement.Shuffled(threeTables)

        // tableNumbers[i] = numéro attribué à l'équipe i.
        let tableNumbers: List<int> = new List<int>()
        var fi: int = 0
        var ti: int = 0
        for i in 0..nb {
            let team: TeamIn = teams.Get(i)
            if (team.Players.Count() == 3 && ti < threeShuffled.Count()) {
                tableNumbers.Add(threeShuffled.Get(ti))
                ti = ti + 1
            } else {
                if (fi < fourTables.Count()) {
                    tableNumbers.Add(fourTables.Get(fi))
                    fi = fi + 1
                } else {
                    tableNumbers.Add(i + 1)
                }
            }
        }

        let seats: List<SeatRow> = new List<SeatRow>()
        var relaisUsed: int = 0
        for ti in 0..nb {
            let team: TeamIn = teams.Get(ti)
            let tableNumber: int = tableNumbers.Get(ti)
            let ordered: List<TeamPlayerIn> = Placement.SortByPlayerNumber(team.Players)
            let assigned: List<string> = Placement.SeatsFor(ordered)
            for idx in 0..ordered.Count() {
                let p: TeamPlayerIn = ordered.Get(idx)
                let row: SeatRow = new SeatRow()
                row.TableNumber = tableNumber
                row.Seat = assigned.Get(idx)
                row.PlayerId = p.PlayerId
                row.TeamId = team.Id
                seats.Add(row)
            }
            // Table de 3 : le relais occupe Nord.
            if (ordered.Count() == 3 && relaisUsed < relaisIds.Count()) {
                let rr: SeatRow = new SeatRow()
                rr.TableNumber = tableNumber
                rr.Seat = "N"
                rr.PlayerId = relaisIds.Get(relaisUsed)
                rr.TeamId = team.Id
                seats.Add(rr)
                relaisUsed = relaisUsed + 1
            }
        }
        return seats
    }

    // Sièges d'une équipe, dans l'ordre de `ordered`.
    //   - 4 joueurs : sièges explicites (team_players.seat) tous renseignés
    //     et distincts → respectés ; sinon ordre des joueurs → N, S, E, O.
    //   - 3 joueurs : Nord est réservé au relais. Sièges explicites
    //     respectés s'ils sont distincts et hors Nord ; sinon S, E, O.
    public static List<string> SeatsFor(List<TeamPlayerIn> ordered) {
        let n: int = ordered.Count()
        let out: List<string> = new List<string>()
        var explicit: bool = n > 0
        for p in ordered {
            if (String.Length(p.Seat) == 0) { explicit = false }
            if (n == 3 && p.Seat == "N") { explicit = false }
        }
        if (explicit) {
            for i in 0..n {
                let pi: TeamPlayerIn = ordered.Get(i)
                for j in 0..i {
                    let pj: TeamPlayerIn = ordered.Get(j)
                    if (pj.Seat == pi.Seat) { explicit = false }
                }
            }
        }
        if (explicit) {
            for p in ordered { out.Add(p.Seat) }
            return out
        }
        var idx: int = 0
        if (n == 3) { idx = 1 }   // S, E, O
        for i in 0..n {
            out.Add(Placement.SeatAt(idx))
            idx = idx + 1
        }
        return out
    }

    // Répartition de n joueurs en tables de 4 (prioritaires) complétées par
    // des tables de 3 — jamais de table de 2. Renvoie [fours, threes], ou
    // une liste vide si n est irréalisable (n < 3, ou n == 5).
    public static List<int> Decompose(int n) {
        let out: List<int> = new List<int>()
        if (n < 3) { return out }
        if (n == 5) { return out }
        let rest: int = n % 4
        var threes: int = 0
        if (rest == 1) { threes = 3 }
        if (rest == 2) { threes = 2 }
        if (rest == 3) { threes = 1 }
        let remaining: int = n - threes * 3
        if (remaining < 0) { return out }
        if (remaining % 4 != 0) { return out }
        out.Add(remaining / 4)
        out.Add(threes)
        return out
    }

    // Mélange une liste d'entiers (Fisher-Yates sur le CSPRNG).
    static List<int> Shuffled(List<int> src) {
        let pool: List<int> = new List<int>()
        for x in src { pool.Add(x) }
        let out: List<int> = new List<int>()
        while (pool.Count() > 0) {
            let j: int = Placement.Below(pool.Count())
            out.Add(pool.Get(j))
            pool.RemoveAt(j)
        }
        return out
    }

    // Consigne de position d'un joueur (team_players.orientation) : "N",
    // "S", "E", "O", "not_north", ou "" (aléatoire / inconnue).
    static string PrefOf(int playerId, List<int> prefIds, List<string> prefVals) {
        for k in 0..prefIds.Count() {
            if (prefIds.Get(k) == playerId) { return prefVals.Get(k) }
        }
        return ""
    }

    static bool InList(List<int> xs, int v) {
        for x in xs { if (x == v) { return true } }
        return false
    }

    // Sièges d'une table formée par niveau, dans l'ordre de `ids`, en
    // respectant au mieux les consignes de position (même règle que le
    // tirage au sort de l'écran « Joueurs présents ») : sièges fixes
    // d'abord, puis « Non Nord » hors Nord, puis les autres au hasard sur
    // les places restantes. Une consigne n'est manquée que si deux joueurs
    // de la même table veulent le même siège (le niveau décide de la table).
    public static List<string> SeatsByPref(List<int> ids, List<string> pool, List<int> prefIds, List<string> prefVals) {
        let idx: List<int> = new List<int>()
        for k in 0..pool.Count() { idx.Add(k) }
        let order: List<int> = Placement.Shuffled(idx)
        let free: List<string> = new List<string>()
        for k in 0..order.Count() { free.Add(pool.Get(order.Get(k))) }

        let pidx: List<int> = new List<int>()
        for k in 0..ids.Count() { pidx.Add(k) }
        let players: List<int> = Placement.Shuffled(pidx)

        let placedIdx: List<int> = new List<int>()
        let placedSeat: List<string> = new List<string>()

        // 1. Sièges fixes.
        for i in players {
            let pref: string = Placement.PrefOf(ids.Get(i), prefIds, prefVals)
            if (pref == "N" || pref == "S" || pref == "E" || pref == "O") {
                var j: int = -1
                for k in 0..free.Count() { if (j < 0 && free.Get(k) == pref) { j = k } }
                if (j >= 0) {
                    placedIdx.Add(i)
                    placedSeat.Add(pref)
                    free.RemoveAt(j)
                }
            }
        }
        // 2. Non Nord.
        for i in players {
            if (!Placement.InList(placedIdx, i)) {
                if (Placement.PrefOf(ids.Get(i), prefIds, prefVals) == "not_north") {
                    var j: int = -1
                    for k in 0..free.Count() { if (j < 0 && free.Get(k) != "N") { j = k } }
                    if (j >= 0) {
                        placedIdx.Add(i)
                        placedSeat.Add(free.Get(j))
                        free.RemoveAt(j)
                    }
                }
            }
        }
        // 3. Les autres (et les consignes impossibles) sur ce qui reste.
        for i in players {
            if (!Placement.InList(placedIdx, i)) {
                if (free.Count() > 0) {
                    placedIdx.Add(i)
                    placedSeat.Add(free.Get(0))
                    free.RemoveAt(0)
                }
            }
        }

        let out: List<string> = new List<string>()
        for i in 0..ids.Count() {
            var seat: string = ""
            for k in 0..placedIdx.Count() { if (placedIdx.Get(k) == i) { seat = placedSeat.Get(k) } }
            out.Add(seat)
        }
        return out
    }

    // Table (0..) de la position `i` dans l'ordre de niveau : les 4·fours
    // premières positions forment les tables de 4, les suivantes les tables
    // de 3 (Nord = Relais).
    static int LevelTableOf(int i, int fours) {
        if (i < 4 * fours) { return i / 4 }
        return fours + (i - 4 * fours) / 3
    }

    static bool LevelSeatExists(int table, int fours, string seat) {
        if (seat == "N") { return table < fours }
        return true
    }

    // Vrai si un AUTRE joueur de la table `table` (position != skip) a déjà
    // la consigne fixe `seat`.
    static bool LevelSeatClaimed(List<int> order, int table, int fours, string seat, int skip, List<int> prefIds, List<string> prefVals) {
        for k in 0..order.Count() {
            if (k != skip && Placement.LevelTableOf(k, fours) == table) {
                if (Placement.PrefOf(order.Get(k), prefIds, prefVals) == seat) { return true }
            }
        }
        return false
    }

    static List<int> SwapAt(List<int> xs, int a, int b) {
        let out: List<int> = new List<int>()
        for k in 0..xs.Count() {
            if (k == a) { out.Add(xs.Get(b)) } else { if (k == b) { out.Add(xs.Get(a)) } else { out.Add(xs.Get(k)) } }
        }
        return out
    }

    // Avant de former les tables par niveau : un joueur à siège fixe dont la
    // place n'existe pas à sa table (« Nord fixe » à une table de 3, où le
    // Nord est le Relais) ou y est déjà demandée par un joueur mieux classé
    // est échangé avec le joueur SANS consigne le plus proche au classement,
    // assis à une table où ce siège est libre (choix du club, 2026-11-25).
    // Le niveau des tables n'est retouché que de cet échange minimal : un
    // joueur déjà échangé ne l'est pas une seconde fois (il ne descend ou ne
    // monte jamais de plus d'un échange). Sans candidat, le joueur reste à
    // sa place et sa consigne est manquée.
    public static List<int> BalanceLevelPrefs(List<int> ordered, int fours, List<int> prefIds, List<string> prefVals) {
        var cur: List<int> = new List<int>()
        for x in ordered { cur.Add(x) }
        let n: int = cur.Count()
        let swapped: List<int> = new List<int>()
        for i in 0..n {
            let pref: string = Placement.PrefOf(cur.Get(i), prefIds, prefVals)
            if (pref == "N" || pref == "S" || pref == "E" || pref == "O") {
                let ti: int = Placement.LevelTableOf(i, fours)
                var blocked: bool = !Placement.LevelSeatExists(ti, fours, pref)
                if (!blocked) {
                    // Déjà pris par un mieux classé de la même table ?
                    for k in 0..i {
                        if (Placement.LevelTableOf(k, fours) == ti && Placement.PrefOf(cur.Get(k), prefIds, prefVals) == pref) { blocked = true }
                    }
                }
                if (blocked) {
                    var best: int = -1
                    for d in 1..n {
                        if (best < 0) {
                            // Le voisin le plus proche, au-dessus puis en dessous.
                            let up: int = i - d
                            let down: int = i + d
                            if (up >= 0 && best < 0) {
                                let tu: int = Placement.LevelTableOf(up, fours)
                                if (tu != ti && Placement.PrefOf(cur.Get(up), prefIds, prefVals) == "" && !Placement.InList(swapped, cur.Get(up)) && Placement.LevelSeatExists(tu, fours, pref) && !Placement.LevelSeatClaimed(cur, tu, fours, pref, up, prefIds, prefVals)) { best = up }
                            }
                            if (down < n && best < 0) {
                                let td: int = Placement.LevelTableOf(down, fours)
                                if (td != ti && Placement.PrefOf(cur.Get(down), prefIds, prefVals) == "" && !Placement.InList(swapped, cur.Get(down)) && Placement.LevelSeatExists(td, fours, pref) && !Placement.LevelSeatClaimed(cur, td, fours, pref, down, prefIds, prefVals)) { best = down }
                            }
                        }
                    }
                    if (best >= 0) {
                        swapped.Add(cur.Get(i))
                        swapped.Add(cur.Get(best))
                        cur = Placement.SwapAt(cur, i, best)
                    }
                }
            }
        }
        return cur
    }

    // Placement « par niveau » : les joueurs arrivent triés du meilleur au
    // moins bon, les 4 premiers forment la table 1, les 4 suivants la table
    // 2, etc. Les tables de 3 sont les dernières (bas de classement) et
    // reçoivent un Relais en Nord, comme partout ailleurs. Le niveau décide
    // de la table ; la place respecte la consigne de position de chaque
    // joueur (migration 011), sinon elle est tirée au sort (SeatsByPref).
    public static List<SeatRow> GenerateLevelSeats(List<int> orderedPlayerIds, List<int> relaisIds, List<int> prefIds, List<string> prefVals) {
        let seats: List<SeatRow> = new List<SeatRow>()
        let n: int = orderedPlayerIds.Count()
        let plan: List<int> = Placement.Decompose(n)
        if (plan.Count() == 0) { return seats }
        let fours: int = plan.Get(0)
        let threes: int = plan.Get(1)
        let order: List<int> = Placement.BalanceLevelPrefs(orderedPlayerIds, fours, prefIds, prefVals)

        var cursor: int = 0
        let pool4: List<string> = new List<string>()
        pool4.Add("N")
        pool4.Add("S")
        pool4.Add("E")
        pool4.Add("O")
        let pool3: List<string> = new List<string>()
        pool3.Add("S")
        pool3.Add("E")
        pool3.Add("O")
        for t in 0..fours {
            let group: List<int> = new List<int>()
            for k in 0..4 { group.Add(order.Get(cursor + k)) }
            cursor = cursor + 4
            let gs: List<string> = Placement.SeatsByPref(group, pool4, prefIds, prefVals)
            for k in 0..4 {
                let row: SeatRow = new SeatRow()
                row.TableNumber = t + 1
                row.Seat = gs.Get(k)
                row.PlayerId = group.Get(k)
                row.TeamId = 0
                seats.Add(row)
            }
        }
        for k in 0..threes {
            let tableNumber: int = fours + k + 1
            let group: List<int> = new List<int>()
            for j in 0..3 { group.Add(order.Get(cursor + j)) }
            cursor = cursor + 3
            let gs: List<string> = Placement.SeatsByPref(group, pool3, prefIds, prefVals)   // S, E, O
            for j in 0..3 {
                let row: SeatRow = new SeatRow()
                row.TableNumber = tableNumber
                row.Seat = gs.Get(j)
                row.PlayerId = group.Get(j)
                row.TeamId = 0
                seats.Add(row)
            }
            if (k < relaisIds.Count()) {
                let rr: SeatRow = new SeatRow()
                rr.TableNumber = tableNumber
                rr.Seat = "N"
                rr.PlayerId = relaisIds.Get(k)
                rr.TeamId = 0
                seats.Add(rr)
            }
        }
        return seats
    }

    // Places du round suivant : offset par siège sur le numéro de table.
    public static List<SeatRow> GenerateNextSeats(List<SeatRow> prevSeats, int offN, int offS, int offE, int offO) {
        let out: List<SeatRow> = new List<SeatRow>()
        if (prevSeats.Count() == 0) { return out }

        var nbTables: int = 0
        for s in prevSeats {
            if (s.TableNumber > nbTables) { nbTables = s.TableNumber }
        }

        for s in prevSeats {
            var off: int = offN
            if (s.Seat == "S") { off = offS }
            if (s.Seat == "E") { off = offE }
            if (s.Seat == "O") { off = offO }
            let row: SeatRow = new SeatRow()
            row.TableNumber = Placement.WrapTable(s.TableNumber, off, nbTables)
            row.Seat = s.Seat
            row.PlayerId = s.PlayerId
            row.TeamId = s.TeamId
            out.Add(row)
        }
        return out
    }

    // Tri stable ascendant par player_number (sélection — 4 éléments).
    public static List<TeamPlayerIn> SortByPlayerNumber(List<TeamPlayerIn> players) {
        let out: List<TeamPlayerIn> = new List<TeamPlayerIn>()
        for p in players { out.Add(p) }
        let n: int = out.Count()
        for i in 0..n {
            var min: int = i
            for j in (i + 1)..n {
                let pj: TeamPlayerIn = out.Get(j)
                let pmin: TeamPlayerIn = out.Get(min)
                if (pj.PlayerNumber < pmin.PlayerNumber) { min = j }
            }
            if (min != i) {
                let tmp: TeamPlayerIn = out.Get(i)
                out.Set(i, out.Get(min))
                out.Set(min, tmp)
            }
        }
        return out
    }
}
