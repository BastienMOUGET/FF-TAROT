namespace App

import Amalgame.Web
import Amalgame.Json

// Module penalty-types — CRUD simple. default_points = décimal (défaut 0).
public class ModPenaltyTypes {

    public static JsonValue Row(List<string> r) {
        let o: JsonValue = J.Obj()
        o.AppendEntry("id", J.CellInt(r.Get(0)))
        o.AppendEntry("code", J.CellStr(r.Get(1)))
        o.AppendEntry("label", J.CellStr(r.Get(2)))
        o.AppendEntry("default_points", J.CellFloat(r.Get(3)))
        return o
    }

    public static HttpResponse List(WebContext ctx, Db db) {
        let rows: List<List<string>> = db.Rows(
            "SELECT id, code, label, default_points FROM penalty_types ORDER BY label ASC",
            Db.NoParams())
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            arr.AppendItem(ModPenaltyTypes.Row(r))
        }
        return J.Ok(arr)
    }

    public static HttpResponse GetById(WebContext ctx, Db db) {
        let id: string = ctx.Param("id")
        let rows: List<List<string>> = db.Rows(
            "SELECT id, code, label, default_points FROM penalty_types WHERE id = ?", Db.P1(id))
        if (rows.Count() == 0) { return HttpErr.NotFound() }
        let r0: List<string> = rows.Get(0)
        return J.Ok(ModPenaltyTypes.Row(r0))
    }

    static HttpResponse Refetch(Db db, int id) {
        let rows: List<List<string>> = db.Rows(
            "SELECT id, code, label, default_points FROM penalty_types WHERE id = ?", Db.P1(String.FromInt(id)))
        let r0: List<string> = rows.Get(0)
        return J.Ok(ModPenaltyTypes.Row(r0))
    }

    // default_points : nombre optionnel (int ou float) → string, défaut "0".
    static string PointsOf(JsonValue b) {
        let pv: JsonValue = b.Get("default_points")
        if (pv.IsInt()) { return String.FromInt(pv.AsInt()) }
        if (pv.IsFloat()) { return String.FromFloat(pv.AsFloat()) }
        return "0"
    }

    public static HttpResponse Create(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        let codeV: JsonValue = b.Get("code")
        let labelV: JsonValue = b.Get("label")
        if (!codeV.IsString()) { return HttpErr.BadRequest("code requis") }
        if (!labelV.IsString()) { return HttpErr.BadRequest("label requis") }
        let code: string = codeV.AsString()
        let label: string = labelV.AsString()
        let pts: string = ModPenaltyTypes.PointsOf(b)

        let ok: bool = db.Exec("INSERT INTO penalty_types (code, label, default_points) VALUES (?, ?, ?)", Db.P3(code, label, pts))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        let resp: HttpResponse = ModPenaltyTypes.Refetch(db, db.LastInsertId())
        return resp.Status(201)
    }

    public static HttpResponse Update(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        let codeV: JsonValue = b.Get("code")
        let labelV: JsonValue = b.Get("label")
        if (!codeV.IsString()) { return HttpErr.BadRequest("code requis") }
        if (!labelV.IsString()) { return HttpErr.BadRequest("label requis") }
        let code: string = codeV.AsString()
        let label: string = labelV.AsString()
        let pts: string = ModPenaltyTypes.PointsOf(b)

        let ps: List<string> = new List<string>()
        ps.Add(code)
        ps.Add(label)
        ps.Add(pts)
        ps.Add(id)
        let ok: bool = db.Exec("UPDATE penalty_types SET code = ?, label = ?, default_points = ? WHERE id = ?", ps)
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        if (db.Changes() == 0) { return HttpErr.NotFound() }
        return ModPenaltyTypes.Refetch(db, String.ToInt(id))
    }

    public static HttpResponse Remove(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let ok: bool = db.Exec("DELETE FROM penalty_types WHERE id = ?", Db.P1(id))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        if (db.Changes() == 0) { return HttpErr.NotFound() }
        return J.NoContent()
    }
}
