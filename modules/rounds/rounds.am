namespace App

import Amalgame.Web
import Amalgame.Json

// Module rounds — tours + génération du placement (Libre par 4).
public class ModRounds {

    static JsonValue RoundRow(List<string> r) {
        let o: JsonValue = J.Obj()
        o.AppendEntry("id", J.CellInt(r.Get(0)))
        o.AppendEntry("sub_tournament_id", J.CellInt(r.Get(1)))
        o.AppendEntry("round_number", J.CellInt(r.Get(2)))
        o.AppendEntry("coef", J.CellFloat(r.Get(3)))
        o.AppendEntry("started_at", J.CellStrN(r.Get(4)))
        o.AppendEntry("closed_at", J.CellStrN(r.Get(5)))
        return o
    }

    static string ROUND_COLS() { return "id, sub_tournament_id, round_number, coef, started_at, closed_at" }

    // Round + sièges groupés par table (réutilisé par create/generate).
    static HttpResponse RoundWithTables(Db db, string id) {
        let rows: List<List<string>> = db.Rows("SELECT " + ModRounds.ROUND_COLS() + " FROM rounds WHERE id = ?", Db.P1(id))
        if (rows.Count() == 0) { return HttpErr.NotFound() }
        let r0: List<string> = rows.Get(0)
        let o: JsonValue = ModRounds.RoundRow(r0)

        let seatRows: List<List<string>> = db.Rows(
            "SELECT s.table_number, s.seat, s.player_id, s.team_id, p.licence, p.name, p.firstname, t.team_number, p.is_relais, (SELECT tp.orientation FROM team_players tp JOIN teams tt ON tt.id = tp.team_id JOIN rounds rr ON rr.sub_tournament_id = tt.sub_tournament_id WHERE rr.id = s.round_id AND tp.player_id = s.player_id LIMIT 1) AS orientation FROM seats s JOIN players p ON p.id = s.player_id LEFT JOIN teams t ON t.id = s.team_id WHERE s.round_id = ? ORDER BY s.table_number ASC, FIELD(s.seat, 'N','S','E','O')",
            Db.P1(id))

        // Groupement par table_number (les lignes sont déjà triées par table).
        let tables: JsonValue = J.Arr()
        var curTable: int = -1
        var curSeats: JsonValue = J.Arr()
        var curObj: JsonValue = J.Obj()
        for i in 0..seatRows.Count() {
            let sr: List<string> = seatRows.Get(i)
            let tnum: int = Db.CellInt(sr.Get(0))
            if (tnum != curTable) {
                if (curTable != -1) {
                    curObj.AppendEntry("seats", curSeats)
                    tables.AppendItem(curObj)
                }
                curTable = tnum
                curObj = J.Obj()
                curObj.AppendEntry("table_number", J.Int(tnum))
                curSeats = J.Arr()
            }
            let seat: JsonValue = J.Obj()
            seat.AppendEntry("table_number", J.CellInt(sr.Get(0)))
            seat.AppendEntry("seat", J.CellStr(sr.Get(1)))
            seat.AppendEntry("player_id", J.CellInt(sr.Get(2)))
            seat.AppendEntry("team_id", J.CellIntN(sr.Get(3)))
            seat.AppendEntry("licence", J.CellStrN(sr.Get(4)))
            seat.AppendEntry("name", J.CellStr(sr.Get(5)))
            seat.AppendEntry("firstname", J.CellStr(sr.Get(6)))
            seat.AppendEntry("team_number", J.CellIntN(sr.Get(7)))
            seat.AppendEntry("is_relais", J.CellBool(sr.Get(8)))
            // Consigne de position du tirage (migration 011), affichée sur
            // la page de la manche pour vérifier qu'elle est tenue.
            seat.AppendEntry("orientation", J.CellStrN(sr.Get(9)))
            curSeats.AppendItem(seat)
        }
        if (curTable != -1) {
            curObj.AppendEntry("seats", curSeats)
            tables.AppendItem(curObj)
        }
        o.AppendEntry("tables", tables)
        return J.Ok(o)
    }

    // GET /api/sub-tournaments/:subTournamentId/rounds
    public static HttpResponse ListBySubTournament(WebContext ctx, Db db) {
        let subId: string = ctx.Param("subTournamentId")
        let rows: List<List<string>> = db.Rows(
            "SELECT " + ModRounds.ROUND_COLS() + " FROM rounds WHERE sub_tournament_id = ? ORDER BY round_number ASC", Db.P1(subId))
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            arr.AppendItem(ModRounds.RoundRow(r))
        }
        return J.Ok(arr)
    }

    // GET /api/rounds/:id
    public static HttpResponse GetById(WebContext ctx, Db db) {
        let id: string = ctx.Param("id")
        return ModRounds.RoundWithTables(db, id)
    }

    // POST /api/sub-tournaments/:subTournamentId/rounds (admin)
    public static HttpResponse Create(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }

        var coef: string = "1.0"
        let pr: JsonResult = Json.Parse(ctx.Body)
        if (pr.Ok) {
            let b: JsonValue = pr.Value
            coef = Fld.NumOr(b, "coef", "1.0")
        }

        let numRows: List<List<string>> = db.Rows(
            "SELECT COALESCE(MAX(round_number), 0) + 1 AS n FROM rounds WHERE sub_tournament_id = ?", Db.P1(subId))
        let nr0: List<string> = numRows.Get(0)
        let roundNumber: int = Db.CellInt(nr0.Get(0))

        let ok: bool = db.Exec("INSERT INTO rounds (sub_tournament_id, round_number, coef) VALUES (?, ?, ?)", Db.P3(subId, String.FromInt(roundNumber), coef))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        let resp: HttpResponse = ModRounds.RoundWithTables(db, String.FromInt(db.LastInsertId()))
        return resp.Status(201)
    }

    // DELETE /api/rounds/:id (admin)
    // Les manches restantes sont renumérotées pour rester 1, 2, 3… :
    // supprimer la manche 1 laissait « Manche 2 … Manche 5 » à l'écran, sans
    // moyen de revenir à 1 (retour terrain n°11).
    public static HttpResponse Remove(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let rows: List<List<string>> = db.Rows("SELECT sub_tournament_id, round_number FROM rounds WHERE id = ?", Db.P1(id))
        if (rows.Count() == 0) { return HttpErr.NotFound() }
        let r0: List<string> = rows.Get(0)
        let subId: string = r0.Get(0)
        let number: string = r0.Get(1)

        db.Begin()
        let ok: bool = db.Exec("DELETE FROM rounds WHERE id = ?", Db.P1(id))
        if (!ok) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        // Décrémenter par ordre croissant : le numéro libéré est repris en
        // premier, la clé unique (sous-tournoi, numéro) n'est jamais violée.
        let okRenum: bool = db.Exec(
            "UPDATE rounds SET round_number = round_number - 1 WHERE sub_tournament_id = ? AND round_number > ? ORDER BY round_number ASC",
            Db.P2(subId, number))
        if (!okRenum) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        db.Commit()
        ModRanking.RefreshAndBroadcast(db, subId)
        return J.NoContent()
    }

    // Ids des joueurs virtuels « Relais », triés 1, 2, 3… ; en crée au
    // besoin pour en avoir `needed`.
    static List<int> RelaisIds(Db db, int needed) {
        let out: List<int> = new List<int>()
        let rows: List<List<string>> = db.Rows("SELECT id FROM players WHERE is_relais = TRUE ORDER BY CAST(firstname AS UNSIGNED) ASC, id ASC", Db.NoParams())
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            out.Add(Db.CellInt(r.Get(0)))
        }
        var k: int = out.Count()
        while (out.Count() < needed) {
            k = k + 1
            let ok: bool = db.Exec("INSERT INTO players (name, firstname, is_relais) VALUES ('Relais', ?, TRUE)", Db.P1(String.FromInt(k)))
            if (!ok) { return out }
            out.Add(db.LastInsertId())
        }
        return out
    }

    // Nombre de tables non validées sur les manches précédant `beforeRound`.
    // Sert de garde au placement par niveau : sans résultats complets, le
    // classement de référence serait faux.
    static int UnvalidatedTables(Db db, string subId, int beforeRound) {
        let rows: List<List<string>> = db.Rows(
            "SELECT COUNT(*) FROM (SELECT s.round_id, s.table_number FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ? AND r.round_number < ? GROUP BY s.round_id, s.table_number) t LEFT JOIN table_results tr ON tr.round_id = t.round_id AND tr.table_number = t.table_number WHERE tr.id IS NULL OR tr.validated = FALSE",
            Db.P2(subId, String.FromInt(beforeRound)))
        if (rows.Count() == 0) { return 0 }
        let r0: List<string> = rows.Get(0)
        return Db.CellInt(r0.Get(0))
    }

    // Joueurs (hors Relais) triés par score cumulé décroissant sur les
    // manches validées qui précèdent `beforeRound` — l'ordre « par niveau ».
    static List<int> LevelOrder(Db db, string subId, int beforeRound) {
        let out: List<int> = new List<int>()
        let rows: List<List<string>> = db.Rows(
            "SELECT s.player_id, COALESCE(SUM(CASE s.seat WHEN 'N' THEN tr.score_n WHEN 'S' THEN tr.score_s WHEN 'E' THEN tr.score_e ELSE tr.score_o END * r.coef), 0) AS total FROM seats s JOIN rounds r ON r.id = s.round_id JOIN players p ON p.id = s.player_id LEFT JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number AND tr.validated = TRUE WHERE r.sub_tournament_id = ? AND r.round_number < ? AND p.is_relais = FALSE GROUP BY s.player_id ORDER BY total DESC, s.player_id ASC",
            Db.P2(subId, String.FromInt(beforeRound)))
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            out.Add(Db.CellInt(r.Get(0)))
        }
        return out
    }

    // POST /api/rounds/:id/generate (admin) — (re)génère le placement.
    public static HttpResponse Generate(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let rounds: List<List<string>> = db.Rows("SELECT id, sub_tournament_id, round_number FROM rounds WHERE id = ?", Db.P1(id))
        if (rounds.Count() == 0) { return HttpErr.NotFound() }
        let rr: List<string> = rounds.Get(0)
        let subId: string = rr.Get(1)
        let roundNumber: int = Db.CellInt(rr.Get(2))

        // Mode de placement du tournoi (migration 008) : mouvement standard,
        // ou tables formées par niveau d'après le classement en cours.
        let subRows: List<List<string>> = db.Rows("SELECT placement_mode, rounds_planned FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subRows.Count() == 0) { return HttpErr.NotFound() }
        let sr: List<string> = subRows.Get(0)
        let mode: string = sr.Get(0)
        let planned: int = Db.CellInt(sr.Get(1))
        var byLevel: bool = false
        if (roundNumber > 1) {
            if (mode == "level") { byLevel = true }
            if (mode == "level_last" && roundNumber >= planned) { byLevel = true }
        }

        var seats: List<SeatRow> = new List<SeatRow>()

        if (byLevel) {
            // Classement cumulé des manches précédentes validées : il faut
            // qu'elles le soient toutes, sinon le niveau ne veut rien dire.
            let missing: int = ModRounds.UnvalidatedTables(db, subId, roundNumber)
            if (missing > 0) {
                return HttpErr.BadRequest("Placement par niveau : " + String.FromInt(missing) + " table(s) des manches précédentes ne sont pas encore validées. Terminez la saisie avant de générer cette manche.")
            }
            let ordered: List<int> = ModRounds.LevelOrder(db, subId, roundNumber)
            if (ordered.Count() == 0) {
                return HttpErr.BadRequest("Placement par niveau impossible : aucun résultat validé sur les manches précédentes.")
            }
            let plan: List<int> = Placement.Decompose(ordered.Count())
            if (plan.Count() == 0) {
                return HttpErr.BadRequest("Placement par niveau impossible avec " + String.FromInt(ordered.Count()) + " joueurs (ni tables de 4 ni de 3).")
            }
            let relaisIds: List<int> = ModRounds.RelaisIds(db, plan.Get(1))
            // Consignes de position du tirage (migration 011) : respectées
            // aussi quand les tables sont reformées par niveau.
            let orientRows: List<List<string>> = db.Rows(
                "SELECT tp.player_id, tp.orientation FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ? AND tp.orientation IS NOT NULL",
                Db.P1(subId))
            let prefIds: List<int> = new List<int>()
            let prefVals: List<string> = new List<string>()
            for i in 0..orientRows.Count() {
                let orow: List<string> = orientRows.Get(i)
                prefIds.Add(Db.CellInt(orow.Get(0)))
                prefVals.Add(orow.Get(1))
            }
            seats = Placement.GenerateLevelSeats(ordered, relaisIds, prefIds, prefVals)
        } else { if (roundNumber == 1) {
            // Équipes + 4 joueurs chacune.
            let teamRows: List<List<string>> = db.Rows("SELECT id FROM teams WHERE sub_tournament_id = ? ORDER BY team_number ASC", Db.P1(subId))
            if (teamRows.Count() == 0) { return HttpErr.BadRequest("Aucune équipe inscrite dans ce sous-tournoi") }
            let teams: List<TeamIn> = new List<TeamIn>()
            for i in 0..teamRows.Count() {
                let trow: List<string> = teamRows.Get(i)
                let tidS: string = trow.Get(0)
                let team: TeamIn = new TeamIn()
                team.Id = Db.CellInt(tidS)
                team.Players = new List<TeamPlayerIn>()
                let prows: List<List<string>> = db.Rows("SELECT player_id, player_number, COALESCE(seat, '') FROM team_players WHERE team_id = ? ORDER BY player_number", Db.P1(tidS))
                for k in 0..prows.Count() {
                    let prow: List<string> = prows.Get(k)
                    let tp: TeamPlayerIn = new TeamPlayerIn()
                    tp.PlayerId = Db.CellInt(prow.Get(0))
                    tp.PlayerNumber = Db.CellInt(prow.Get(1))
                    tp.Seat = prow.Get(2)
                    team.Players.Add(tp)
                }
                if (team.Players.Count() != 3 && team.Players.Count() != 4) { return HttpErr.BadRequest("Équipe incomplète : " + tidS) }
                teams.Add(team)
            }
            // Relais pour les tables de 3 : un par équipe de 3, créés si
            // la base n'en a pas assez (migration 005 en pose 3).
            var nbThrees: int = 0
            for t in teams { if (t.Players.Count() == 3) { nbThrees = nbThrees + 1 } }
            let relaisIds: List<int> = ModRounds.RelaisIds(db, nbThrees)
            seats = Placement.GenerateInitialSeats(teams, relaisIds)
        } else {
            let prevRows: List<List<string>> = db.Rows("SELECT id FROM rounds WHERE sub_tournament_id = ? AND round_number = ?", Db.P2(subId, String.FromInt(roundNumber - 1)))
            if (prevRows.Count() == 0) { return HttpErr.BadRequest("Round précédent introuvable") }
            let prow0: List<string> = prevRows.Get(0)
            let prevId: string = prow0.Get(0)
            let prevSeatRows: List<List<string>> = db.Rows("SELECT table_number, seat, player_id, team_id FROM seats WHERE round_id = ?", Db.P1(prevId))
            if (prevSeatRows.Count() == 0) { return HttpErr.BadRequest("Le round précédent ne contient pas de mise en place") }
            let prevSeats: List<SeatRow> = new List<SeatRow>()
            for i in 0..prevSeatRows.Count() {
                let sr: List<string> = prevSeatRows.Get(i)
                let row: SeatRow = new SeatRow()
                row.TableNumber = Db.CellInt(sr.Get(0))
                row.Seat = sr.Get(1)
                row.PlayerId = Db.CellInt(sr.Get(2))
                row.TeamId = Db.CellInt(sr.Get(3))
                prevSeats.Add(row)
            }
            var nbTables: int = 0
            for s in prevSeats { if (s.TableNumber > nbTables) { nbTables = s.TableNumber } }
            // Le mouvement dépend du nombre de tables ET de la position
            // jouée (migration 009) : on passe le numéro de la manche.
            let offs: List<int> = ModMovementPatterns.OffsetsForPosition(db, nbTables, roundNumber)
            seats = Placement.GenerateNextSeats(prevSeats, offs.Get(0), offs.Get(1), offs.Get(2), offs.Get(3))
        } }

        // Persistance transactionnelle.
        // table_results est indexé par (round_id, table_number), pas par joueur :
        // sans ce nettoyage, régénérer la mise en place laisserait les scores déjà
        // saisis rattachés au n° de table alors que d'autres joueurs peuvent
        // désormais s'y trouver. On les supprime pour tenir la promesse déjà
        // faite à l'utilisateur ("les scores éventuels seront perdus").
        db.Begin()
        let delResOk: bool = db.Exec("DELETE FROM table_results WHERE round_id = ?", Db.P1(id))
        if (!delResOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        let delOk: bool = db.Exec("DELETE FROM seats WHERE round_id = ?", Db.P1(id))
        if (!delOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        for i in 0..seats.Count() {
            let s: SeatRow = seats.Get(i)
            let ps: List<string> = new List<string>()
            ps.Add(id)
            ps.Add(String.FromInt(s.TableNumber))
            ps.Add(s.Seat)
            ps.Add(String.FromInt(s.PlayerId))
            // TeamId 0 = placement par niveau : les tables ne suivent plus
            // les équipes d'inscription, la colonne reste NULL.
            var insOk: bool = false
            if (s.TeamId > 0) {
                ps.Add(String.FromInt(s.TeamId))
                insOk = db.Exec("INSERT INTO seats (round_id, table_number, seat, player_id, team_id) VALUES (?, ?, ?, ?, ?)", ps)
            } else {
                insOk = db.Exec("INSERT INTO seats (round_id, table_number, seat, player_id, team_id) VALUES (?, ?, ?, ?, NULL)", ps)
            }
            if (!insOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        }
        db.Commit()

        return ModRounds.RoundWithTables(db, id)
    }
}
