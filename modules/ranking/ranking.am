namespace App

import Amalgame.Web
import Amalgame.Json
import Amalgame.Math

// Module ranking — classement Libre par 4 (somme directe des scores validés
// × coef), PCN géométrique avec abattement, PP par grille. compute() est
// idempotent (DELETE + INSERT des rankings).
public class RankEntry {
    public PlayerId:     int
    public Name:         string
    public Firstname:    string
    public RoundsPlayed: int
    public Total:        float
    public TotalGeneral: float
    public Place:        int
    public Pcn:          float
    public Pp:           float
    public RankEntry() {}
}

// Une ligne du classement "Challenge" (agrégation de sous-tournois).
public class ChallengeEntry {
    public PlayerId: int
    public Licence:  string
    public Name:     string
    public Firstname: string
    public Played:   int
    public Points:   float
    public Place:    int
    public ChallengeEntry() {}
}

public class ModRanking {

    // abatement = 0.69 + (nb_table - 3)*0.01, capé [0, 0.95].
    static float Abatement(int nbTables) {
        var ab: float = 0.69 + (nbTables - 3) * 0.01
        if (ab > 0.95) { ab = 0.95 }
        if (ab < 0.0) { ab = 0.0 }
        return ab
    }

    // PCN par place (index = place-1), pour les nbPcn = nbTables*2 meilleurs.
    // Valeurs stockées en string (le float ne survit pas au boxing générique).
    static List<string> PcnList(int nbTables, float indicePcn) {
        let out: List<string> = new List<string>()
        if (indicePcn <= 0.0) { return out }
        if (nbTables <= 0) { return out }
        let pcnBase: float = nbTables * 40.0 * indicePcn
        let ab: float = ModRanking.Abatement(nbTables)
        let nbPcn: int = nbTables * 2
        var prev: float = pcnBase
        for place in 1..(nbPcn + 1) {
            var val: float = pcnBase
            if (place != 1) { val = Math.Floor(prev * ab) }
            if (val > 80.0) { val = 80.0 }
            if (val < 0.0) { val = 0.0 }
            out.Add(String.FromFloat(val))
            prev = val
        }
        return out
    }

    // Map<string,string> (float stocké en string) → float.
    static float MapGetF(Map<string, string> m, string k) {
        if (m.Has(k)) { return String.ToFloat(m.Get(k)) }
        return 0.0
    }
    static int MapGetI(Map<string, int> m, string k) {
        if (m.Has(k)) { return m.Get(k) }
        return 0
    }

    // Calcule + persiste le classement. Renvoie false si sous-tournoi absent.
    public static bool Compute(Db db, string subId) {
        let subt: List<List<string>> = db.Rows(
            "SELECT st.id, st.tournament_id, st.indice_pcn, st.championnat, t.coef_default, st.imported FROM sub_tournaments st JOIN tournaments t ON t.id = st.tournament_id WHERE st.id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return false }
        let s0: List<string> = subt.Get(0)
        // Tournoi importé (classement externe) : ses lignes de rankings sont
        // la seule donnée, on ne les recalcule jamais.
        if (Db.CellBool(s0.Get(5))) { return true }
        let tournamentId: string = s0.Get(1)
        var coef: float = Db.CellFloat(s0.Get(4))
        if (coef == 0.0) { coef = 1.0 }
        let indicePcn: float = Db.CellFloat(s0.Get(2))

        // 1. Joueurs inscrits (via team_players)
        let players: List<List<string>> = db.Rows(
            "SELECT DISTINCT p.id, p.name, p.firstname FROM players p WHERE p.is_relais = FALSE AND (p.id IN (SELECT tp.player_id FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ?) OR p.id IN (SELECT s.player_id FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ?))", Db.P2(subId, subId))

        // 2. Rounds
        let rounds: List<List<string>> = db.Rows(
            "SELECT id, round_number, coef FROM rounds WHERE sub_tournament_id = ? ORDER BY round_number ASC", Db.P1(subId))

        // 3. Scores par joueur (sièges × table_results validés × round_coef)
        let scoreByPlayer: Map<string, string> = new Map<string, string>()
        let roundsPlayed: Map<string, int> = new Map<string, int>()
        var lastRoundId: string = ""
        for ri in 0..rounds.Count() {
            let rr: List<string> = rounds.Get(ri)
            lastRoundId = rr.Get(0)
        }
        for ri in 0..rounds.Count() {
            let rr: List<string> = rounds.Get(ri)
            let rid: string = rr.Get(0)
            let seatRows: List<List<string>> = db.Rows(
                "SELECT s.player_id, s.seat, tr.score_n, tr.score_s, tr.score_e, tr.score_o, tr.validated, r.coef FROM seats s JOIN rounds r ON r.id = s.round_id LEFT JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number WHERE s.round_id = ?", Db.P1(rid))
            for i in 0..seatRows.Count() {
                let row: List<string> = seatRows.Get(i)
                let pid: string = row.Get(0)
                let seat: string = row.Get(1)
                let validated: string = row.Get(6)
                if (!Db.CellBool(validated)) { continue }
                var cell: string = ""
                if (seat == "N") { cell = row.Get(2) }
                if (seat == "S") { cell = row.Get(3) }
                if (seat == "E") { cell = row.Get(4) }
                if (seat == "O") { cell = row.Get(5) }
                if (Db.IsNull(cell)) { continue }
                var rcoef: float = Db.CellFloat(row.Get(7))
                if (rcoef == 0.0) { rcoef = 1.0 }
                let sc: float = Db.CellFloat(cell) * rcoef
                scoreByPlayer.Set(pid, String.FromFloat(ModRanking.MapGetF(scoreByPlayer, pid) + sc))
                roundsPlayed.Set(pid, ModRanking.MapGetI(roundsPlayed, pid) + 1)
            }
        }

        // 4. Pénalités (somme par joueur pour le tournoi)
        let penByPlayer: Map<string, string> = new Map<string, string>()
        let penRows: List<List<string>> = db.Rows(
            "SELECT player_id, COALESCE(SUM(points),0) FROM penalties WHERE tournament_id = ? GROUP BY player_id", Db.P1(tournamentId))
        for i in 0..penRows.Count() {
            let pr: List<string> = penRows.Get(i)
            penByPlayer.Set(pr.Get(0), pr.Get(1))
        }

        // 5. Construction des entrées
        let entries: List<RankEntry> = new List<RankEntry>()
        for i in 0..players.Count() {
            let p: List<string> = players.Get(i)
            let pid: string = p.Get(0)
            let e: RankEntry = new RankEntry()
            e.PlayerId = Db.CellInt(pid)
            e.Name = p.Get(1)
            e.Firstname = p.Get(2)
            e.RoundsPlayed = ModRanking.MapGetI(roundsPlayed, pid)
            let sumScores: float = ModRanking.MapGetF(scoreByPlayer, pid)
            e.Total = sumScores * coef
            let penalty: float = ModRanking.MapGetF(penByPlayer, pid)
            e.TotalGeneral = e.Total + penalty * coef
            entries.Add(e)
        }

        // 6. Tri total_general DESC + places (égalités = même place)
        ModRanking.SortDesc(entries)
        var place: int = 1
        for i in 0..entries.Count() {
            let e: RankEntry = entries.Get(i)
            if (i > 0) {
                let prev: RankEntry = entries.Get(i - 1)
                if (e.TotalGeneral < prev.TotalGeneral) { place = i + 1 }
            }
            e.Place = place
        }

        // 7. nb_tables (dernier round) + PCN
        var nbTables: int = 0
        if (String.Length(lastRoundId) > 0) {
            let tc: List<List<string>> = db.Rows("SELECT COUNT(DISTINCT table_number) FROM seats WHERE round_id = ?", Db.P1(lastRoundId))
            let tc0: List<string> = tc.Get(0)
            nbTables = Db.CellInt(tc0.Get(0))
        }
        let pcnList: List<string> = ModRanking.PcnList(nbTables, indicePcn)

        // 8. Grille PP
        let ppByPlace: Map<string, string> = new Map<string, string>()
        let ppRows: List<List<string>> = db.Rows("SELECT place, pp FROM pp_grids WHERE sub_tournament_id = ?", Db.P1(subId))
        for i in 0..ppRows.Count() {
            let pp: List<string> = ppRows.Get(i)
            ppByPlace.Set(pp.Get(0), pp.Get(1))
        }

        // 9. pcn/pp par place
        for i in 0..entries.Count() {
            let e: RankEntry = entries.Get(i)
            if (e.Place <= pcnList.Count()) { e.Pcn = String.ToFloat(pcnList.Get(e.Place - 1)) } else { e.Pcn = 0.0 }
            e.Pp = ModRanking.MapGetF(ppByPlace, String.FromInt(e.Place))
        }

        // 10. Persistance idempotente
        db.Begin()
        let delOk: bool = db.Exec("DELETE FROM rankings WHERE sub_tournament_id = ?", Db.P1(subId))
        if (!delOk) { db.Rollback() return false }
        for i in 0..entries.Count() {
            let e: RankEntry = entries.Get(i)
            let ps: List<string> = new List<string>()
            ps.Add(subId)
            ps.Add(String.FromInt(e.PlayerId))
            ps.Add(String.FromInt(e.RoundsPlayed))
            ps.Add(String.FromFloat(e.Total))
            ps.Add(String.FromFloat(e.TotalGeneral))
            ps.Add(String.FromInt(e.Place))
            ps.Add(String.FromFloat(e.Pcn))
            ps.Add(String.FromFloat(e.Pp))
            let insOk: bool = db.Exec("INSERT INTO rankings (sub_tournament_id, player_id, rounds_played, total, total_general, place, pcn, pp, eliminated) VALUES (?, ?, ?, ?, ?, ?, ?, ?, FALSE)", ps)
            if (!insOk) { db.Rollback() return false }
        }
        db.Commit()
        return true
    }

    // Tri décroissant par TotalGeneral (sélection).
    static void SortDesc(List<RankEntry> xs) {
        let n: int = xs.Count()
        for i in 0..n {
            var best: int = i
            for j in (i + 1)..n {
                let xj: RankEntry = xs.Get(j)
                let xb: RankEntry = xs.Get(best)
                if (xj.TotalGeneral > xb.TotalGeneral) { best = j }
            }
            if (best != i) {
                let tmp: RankEntry = xs.Get(i)
                xs.Set(i, xs.Get(best))
                xs.Set(best, tmp)
            }
        }
    }

    // Recompute + broadcast `ranking:update` (payload {sub_tournament_id, ranking}).
    // Le socket vit dans db.Io (injecté dans Main).
    public static void RefreshAndBroadcast(Db db, string subId) {
        if (!ModRanking.Compute(db, subId)) { return }
        let payload: string = "{\"sub_tournament_id\":" + subId + ",\"ranking\":" + ModRanking.RankingJson(db, subId) + "}"
        db.Io.Emit("ranking:update", payload)
    }

    // Refresh à partir d'un round (récupère son sous-tournoi).
    public static void RefreshForRound(Db db, string roundId) {
        let rows: List<List<string>> = db.Rows("SELECT sub_tournament_id FROM rounds WHERE id = ?", Db.P1(roundId))
        if (rows.Count() > 0) {
            let r0: List<string> = rows.Get(0)
            ModRanking.RefreshAndBroadcast(db, r0.Get(0))
        }
    }

    // Refresh à partir d'un table_result (handlers de donnes).
    public static void RefreshForTr(Db db, string trId) {
        let rows: List<List<string>> = db.Rows("SELECT r.sub_tournament_id FROM table_results tr JOIN rounds r ON r.id = tr.round_id WHERE tr.id = ?", Db.P1(trId))
        if (rows.Count() > 0) {
            let r0: List<string> = rows.Get(0)
            ModRanking.RefreshAndBroadcast(db, r0.Get(0))
        }
    }

    // Refresh de tous les sous-tournois d'un tournoi (pénalités).
    public static void RefreshForTournament(Db db, string tournamentId) {
        let rows: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE tournament_id = ?", Db.P1(tournamentId))
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            ModRanking.RefreshAndBroadcast(db, r.Get(0))
        }
    }

    // Le classement d'un sous-tournoi en tableau JSON (string).
    public static string RankingJson(Db db, string subId) {
        let rows: List<List<string>> = db.Rows(
            "SELECT r.player_id, p.licence, p.name, p.firstname, r.rounds_played, r.total, r.total_general, r.place, r.pcn, r.pp, r.eliminated, r.updated_at FROM rankings r JOIN players p ON p.id = r.player_id WHERE r.sub_tournament_id = ? AND p.is_relais = FALSE ORDER BY r.place ASC, p.name ASC", Db.P1(subId))
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.CellInt(r.Get(0)))
            o.AppendEntry("licence", J.CellStrN(r.Get(1)))
            o.AppendEntry("name", J.CellStr(r.Get(2)))
            o.AppendEntry("firstname", J.CellStr(r.Get(3)))
            o.AppendEntry("rounds_played", J.CellInt(r.Get(4)))
            o.AppendEntry("total", J.CellFloat(r.Get(5)))
            o.AppendEntry("total_general", J.CellFloat(r.Get(6)))
            o.AppendEntry("place", J.CellInt(r.Get(7)))
            o.AppendEntry("pcn", J.CellFloat(r.Get(8)))
            o.AppendEntry("pp", J.CellFloat(r.Get(9)))
            o.AppendEntry("eliminated", J.CellBool(r.Get(10)))
            o.AppendEntry("updated_at", J.CellStrN(r.Get(11)))
            arr.AppendItem(o)
        }
        return Json.Encode(arr)
    }

    // GET /api/sub-tournaments/:subTournamentId/ranking
    // Classement général arrêté après la manche `through` : cumul des tables
    // validées des manches 1..through. Sert à suivre le tournoi manche par
    // manche (retour terrain n°9) et à former les tables « par niveau ».
    // Les pénalités, qui portent sur le challenge entier, ne sont comptées
    // que dans le classement final.
    static HttpResponse RankingThroughRound(Db db, string subId, string through) {
        let rows: List<List<string>> = db.Rows(
            "SELECT s.player_id, p.licence, p.name, p.firstname, COUNT(tr.id) AS played, COALESCE(SUM(CASE s.seat WHEN 'N' THEN tr.score_n WHEN 'S' THEN tr.score_s WHEN 'E' THEN tr.score_e ELSE tr.score_o END * r.coef), 0) AS total FROM seats s JOIN rounds r ON r.id = s.round_id JOIN players p ON p.id = s.player_id LEFT JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number AND tr.validated = TRUE WHERE r.sub_tournament_id = ? AND r.round_number <= ? AND p.is_relais = FALSE GROUP BY s.player_id, p.licence, p.name, p.firstname ORDER BY total DESC, p.name ASC",
            Db.P2(subId, through))
        let arr: JsonValue = J.Arr()
        var place: int = 1
        var prev: float = 0.0
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            let total: float = Db.CellFloat(r.Get(5))
            if (i > 0 && total < prev) { place = i + 1 }
            prev = total
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.CellInt(r.Get(0)))
            o.AppendEntry("licence", J.CellStrN(r.Get(1)))
            o.AppendEntry("name", J.CellStr(r.Get(2)))
            o.AppendEntry("firstname", J.CellStr(r.Get(3)))
            o.AppendEntry("rounds_played", J.CellInt(r.Get(4)))
            o.AppendEntry("total", J.Float(total))
            o.AppendEntry("total_general", J.Float(total))
            o.AppendEntry("place", J.Int(place))
            o.AppendEntry("pcn", J.Float(0.0))
            o.AppendEntry("pp", J.Float(0.0))
            o.AppendEntry("eliminated", J.Bool(false))
            o.AppendEntry("updated_at", J.Null())
            arr.AppendItem(o)
        }
        return J.Ok(arr)
    }

    // GET /api/sub-tournaments/:subTournamentId/ranking-detail
    // Classement général avec le détail manche par manche : une colonne par
    // manche dans l'écran du classement, comme le classement du Challenge a
    // une colonne par tournoi (retour terrain n°10).
    public static HttpResponse GetRankingDetail(WebContext ctx, Db db) {
        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }

        // ?through_round=N : classement arrêté après la manche N. Les manches
        // suivantes, même déjà saisies, sont ignorées — colonnes comprises
        // (retour terrain n°13).
        let through: string = ctx.QueryParam("through_round")
        var rounds: List<List<string>> = new List<List<string>>()
        if (String.Length(through) > 0) {
            rounds = db.Rows(
                "SELECT id, round_number FROM rounds WHERE sub_tournament_id = ? AND round_number <= ? ORDER BY round_number ASC",
                Db.P2(subId, through))
        } else {
            rounds = db.Rows(
                "SELECT id, round_number FROM rounds WHERE sub_tournament_id = ? ORDER BY round_number ASC", Db.P1(subId))
        }

        // Score par joueur et par manche (tables validées seulement).
        let byKey: Map<string, string> = new Map<string, string>()
        let rows: List<List<string>> = db.Rows(
            "SELECT s.player_id, r.round_number, CASE s.seat WHEN 'N' THEN tr.score_n WHEN 'S' THEN tr.score_s WHEN 'E' THEN tr.score_e ELSE tr.score_o END * r.coef AS sc FROM seats s JOIN rounds r ON r.id = s.round_id JOIN players p ON p.id = s.player_id JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number AND tr.validated = TRUE WHERE r.sub_tournament_id = ? AND p.is_relais = FALSE",
            Db.P1(subId))
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            byKey.Set(r.Get(0) + "|" + r.Get(1), r.Get(2))
        }

        // Sans borne : le classement officiel (table rankings), qui porte les
        // PCN et les PP. Avec borne : cumul recalculé sur les manches 1..N.
        var rk: List<List<string>> = new List<List<string>>()
        if (String.Length(through) > 0) {
            rk = db.Rows(
                "SELECT s.player_id, p.licence, p.name, p.firstname, COUNT(tr.id) AS played, COALESCE(SUM(CASE s.seat WHEN 'N' THEN tr.score_n WHEN 'S' THEN tr.score_s WHEN 'E' THEN tr.score_e ELSE tr.score_o END * r.coef), 0) AS total, COALESCE(SUM(CASE s.seat WHEN 'N' THEN tr.score_n WHEN 'S' THEN tr.score_s WHEN 'E' THEN tr.score_e ELSE tr.score_o END * r.coef), 0) AS total2, 0 AS place, 0 AS pcn, 0 AS pp FROM seats s JOIN rounds r ON r.id = s.round_id JOIN players p ON p.id = s.player_id LEFT JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number AND tr.validated = TRUE WHERE r.sub_tournament_id = ? AND r.round_number <= ? AND p.is_relais = FALSE GROUP BY s.player_id, p.licence, p.name, p.firstname ORDER BY total DESC, p.name ASC",
                Db.P2(subId, through))
        } else {
            rk = db.Rows(
                "SELECT r.player_id, p.licence, p.name, p.firstname, r.rounds_played, r.total, r.total_general, r.place, r.pcn, r.pp FROM rankings r JOIN players p ON p.id = r.player_id WHERE r.sub_tournament_id = ? AND p.is_relais = FALSE ORDER BY r.place ASC, p.name ASC",
                Db.P1(subId))
        }

        let arr: JsonValue = J.Arr()
        // Les places d'un classement borné sont recalculées ici (égalité de
        // total = même place).
        var place: int = 1
        var prev: float = 0.0
        for i in 0..rk.Count() {
            let r: List<string> = rk.Get(i)
            let pid: string = r.Get(0)
            var pl: int = Db.CellInt(r.Get(7))
            if (String.Length(through) > 0) {
                let tot: float = Db.CellFloat(r.Get(6))
                if (i > 0 && tot < prev) { place = i + 1 }
                prev = tot
                pl = place
            }
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.CellInt(pid))
            o.AppendEntry("licence", J.CellStrN(r.Get(1)))
            o.AppendEntry("name", J.CellStr(r.Get(2)))
            o.AppendEntry("firstname", J.CellStr(r.Get(3)))
            o.AppendEntry("rounds_played", J.CellInt(r.Get(4)))
            o.AppendEntry("total", J.CellFloat(r.Get(5)))
            o.AppendEntry("total_general", J.CellFloat(r.Get(6)))
            o.AppendEntry("place", J.Int(pl))
            o.AppendEntry("pcn", J.CellFloat(r.Get(8)))
            o.AppendEntry("pp", J.CellFloat(r.Get(9)))
            let det: JsonValue = J.Arr()
            for ri in 0..rounds.Count() {
                let rw: List<string> = rounds.Get(ri)
                let key: string = pid + "|" + rw.Get(1)
                if (byKey.Has(key)) { det.AppendItem(J.Float(String.ToFloat(byKey.Get(key)))) }
                else { det.AppendItem(J.Null()) }
            }
            o.AppendEntry("rounds", det)
            arr.AppendItem(o)
        }

        let rArr: JsonValue = J.Arr()
        for ri in 0..rounds.Count() {
            let rw: List<string> = rounds.Get(ri)
            let ro: JsonValue = J.Obj()
            ro.AppendEntry("id", J.CellInt(rw.Get(0)))
            ro.AppendEntry("round_number", J.CellInt(rw.Get(1)))
            rArr.AppendItem(ro)
        }
        let out: JsonValue = J.Obj()
        out.AppendEntry("rounds", rArr)
        out.AppendEntry("ranking", arr)
        if (String.Length(through) > 0) { out.AppendEntry("through_round", J.CellInt(through)) }
        else { out.AppendEntry("through_round", J.Null()) }
        return J.Ok(out)
    }

    public static HttpResponse GetRanking(WebContext ctx, Db db) {
        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }
        let through: string = ctx.QueryParam("through_round")
        if (String.Length(through) > 0) { return ModRanking.RankingThroughRound(db, subId, through) }
        let rows: List<List<string>> = db.Rows(
            "SELECT r.player_id, p.licence, p.name, p.firstname, r.rounds_played, r.total, r.total_general, r.place, r.pcn, r.pp, r.eliminated, r.updated_at FROM rankings r JOIN players p ON p.id = r.player_id WHERE r.sub_tournament_id = ? AND p.is_relais = FALSE ORDER BY r.place ASC, p.name ASC", Db.P1(subId))
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.CellInt(r.Get(0)))
            o.AppendEntry("licence", J.CellStrN(r.Get(1)))
            o.AppendEntry("name", J.CellStr(r.Get(2)))
            o.AppendEntry("firstname", J.CellStr(r.Get(3)))
            o.AppendEntry("rounds_played", J.CellInt(r.Get(4)))
            o.AppendEntry("total", J.CellFloat(r.Get(5)))
            o.AppendEntry("total_general", J.CellFloat(r.Get(6)))
            o.AppendEntry("place", J.CellInt(r.Get(7)))
            o.AppendEntry("pcn", J.CellFloat(r.Get(8)))
            o.AppendEntry("pp", J.CellFloat(r.Get(9)))
            o.AppendEntry("eliminated", J.CellBool(r.Get(10)))
            o.AppendEntry("updated_at", J.CellStrN(r.Get(11)))
            arr.AppendItem(o)
        }
        return J.Ok(arr)
    }

    // Tri décroissant par Points (classement Challenge).
    static void SortDescChallenge(List<ChallengeEntry> xs) {
        let n: int = xs.Count()
        for i in 0..n {
            var best: int = i
            for j in (i + 1)..n {
                let xj: ChallengeEntry = xs.Get(j)
                let xb: ChallengeEntry = xs.Get(best)
                if (xj.Points > xb.Points) { best = j }
            }
            if (best != i) {
                let tmp: ChallengeEntry = xs.Get(i)
                xs.Set(i, xs.Get(best))
                xs.Set(best, tmp)
            }
        }
    }

    // GET /api/tournaments/:tournamentId/challenge-ranking
    // Classement "Challenge" agrégeant le classement final de tous les
    // sous-tournois (Tournois hebdomadaires) d'un tournoi (Challenge
    // trimestriel), comme ChallengeLib214.xls : soit points par place
    // (1er = N points si N joueurs, dernier = 1 point), soit cumul brut
    // des points de chaque sous-tournoi — mode choisi via
    // tournaments.challenge_mode.
    // GET /api/rounds/:id/ranking — classement d'UNE manche.
    // Une ligne par joueur placé : table, siège (orientation tirée au sort,
    // demandée en colonne des classements), score de la manche × coef, et
    // si la table est validée. Les joueurs d'une table non encore saisie ou
    // non validée sont listés sans place, en fin de liste.
    public static HttpResponse GetRoundRanking(WebContext ctx, Db db) {
        let roundId: string = ctx.Param("id")
        let rrows: List<List<string>> = db.Rows("SELECT id, sub_tournament_id, round_number, coef FROM rounds WHERE id = ?", Db.P1(roundId))
        if (rrows.Count() == 0) { return HttpErr.NotFound() }
        let rr: List<string> = rrows.Get(0)
        var coef: float = Db.CellFloat(rr.Get(3))
        if (coef == 0.0) { coef = 1.0 }

        let rows: List<List<string>> = db.Rows(
            "SELECT s.player_id, p.licence, p.name, p.firstname, s.table_number, s.seat, tr.score_n, tr.score_s, tr.score_e, tr.score_o, COALESCE(tr.validated, 0), (tr.id IS NOT NULL) FROM seats s JOIN players p ON p.id = s.player_id LEFT JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number WHERE s.round_id = ? AND p.is_relais = FALSE ORDER BY s.table_number ASC, FIELD(s.seat, 'N','S','E','O')",
            Db.P1(roundId))

        let entries: List<RankEntry> = new List<RankEntry>()
        let pending: List<RankEntry> = new List<RankEntry>()
        let tableOf: Map<string, int> = new Map<string, int>()
        let seatOf: Map<string, string> = new Map<string, string>()
        let licOf: Map<string, string> = new Map<string, string>()
        let validatedOf: Map<string, int> = new Map<string, int>()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            let pid: string = r.Get(0)
            let seat: string = r.Get(5)
            let e: RankEntry = new RankEntry()
            e.PlayerId = Db.CellInt(pid)
            e.Name = r.Get(2)
            e.Firstname = r.Get(3)
            e.RoundsPlayed = 1
            tableOf.Set(pid, Db.CellInt(r.Get(4)))
            seatOf.Set(pid, seat)
            licOf.Set(pid, r.Get(1))
            let validated: bool = Db.CellBool(r.Get(10))
            let hasResult: bool = Db.CellBool(r.Get(11))
            var cell: string = ""
            if (seat == "N") { cell = r.Get(6) }
            if (seat == "S") { cell = r.Get(7) }
            if (seat == "E") { cell = r.Get(8) }
            if (seat == "O") { cell = r.Get(9) }
            if (hasResult && !Db.IsNull(cell)) {
                e.Total = Db.CellFloat(cell) * coef
                e.TotalGeneral = e.Total
            } else {
                e.Total = 0.0
                e.TotalGeneral = 0.0
            }
            if (validated) { validatedOf.Set(pid, 1) } else { validatedOf.Set(pid, 0) }
            if (hasResult) { entries.Add(e) } else { pending.Add(e) }
        }
        ModRanking.SortDesc(entries)
        var place: int = 0
        var prev: float = 0.0
        for i in 0..entries.Count() {
            let e: RankEntry = entries.Get(i)
            if (i == 0 || e.TotalGeneral != prev) { place = i + 1 }
            e.Place = place
            prev = e.TotalGeneral
        }
        for e in pending { e.Place = 0 entries.Add(e) }

        let o: JsonValue = J.Obj()
        o.AppendEntry("round_id", J.CellInt(rr.Get(0)))
        o.AppendEntry("sub_tournament_id", J.CellInt(rr.Get(1)))
        o.AppendEntry("round_number", J.CellInt(rr.Get(2)))
        o.AppendEntry("coef", J.Float(coef))
        let arr: JsonValue = J.Arr()
        for e in entries {
            let pid: string = String.FromInt(e.PlayerId)
            let eo: JsonValue = J.Obj()
            eo.AppendEntry("player_id", J.Int(e.PlayerId))
            eo.AppendEntry("licence", J.CellStrN(ModRanking.MapGetS(licOf, pid)))
            eo.AppendEntry("name", J.Str(e.Name))
            eo.AppendEntry("firstname", J.Str(e.Firstname))
            eo.AppendEntry("table_number", J.Int(ModRanking.MapGetI(tableOf, pid)))
            eo.AppendEntry("seat", J.Str(ModRanking.MapGetS(seatOf, pid)))
            if (e.Place > 0) { eo.AppendEntry("score", J.Float(e.TotalGeneral)) } else { eo.AppendEntry("score", J.Null()) }
            eo.AppendEntry("place", J.Int(e.Place))
            eo.AppendEntry("validated", J.Bool(ModRanking.MapGetI(validatedOf, pid) == 1))
            arr.AppendItem(eo)
        }
        o.AppendEntry("ranking", arr)
        return J.Ok(o)
    }

    static string MapGetS(Map<string, string> m, string k) {
        if (!m.Has(k)) { return "" }
        return m.Get(k)
    }

    // POST /api/tournaments/:tournamentId/import-ranking (admin)
    // Importe un classement de tournoi tenu hors PABB90 (CSV d'un classeur Excel)
    // dans le Challenge : crée un tournoi marqué `imported` et ses lignes de
    // `rankings`. Corps : { label, rows: [{place, licence, name, firstname,
    // points, pcn}] }. Joueur reconnu par licence, sinon par nom + prénom
    // (insensible à la casse), sinon créé.
    public static HttpResponse ImportRanking(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }
        let tid: string = ctx.Param("tournamentId")
        let trows: List<List<string>> = db.Rows("SELECT id FROM tournaments WHERE id = ?", Db.P1(tid))
        if (trows.Count() == 0) { return HttpErr.NotFound() }
        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        if (!Fld.HasStr(b, "label")) { return HttpErr.BadRequest("label requis") }
        let label: string = Fld.Str(b, "label")
        let rowsV: JsonValue = b.Get("rows")
        if (!rowsV.IsArray()) { return HttpErr.BadRequest("rows doit être un tableau") }
        if (rowsV.Length() == 0) { return HttpErr.BadRequest("Aucune ligne à importer") }

        db.Begin()
        let insOk: bool = db.Exec("INSERT INTO sub_tournaments (tournament_id, label, imported) VALUES (?, ?, TRUE)", Db.P2(tid, label))
        if (!insOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        let subId: string = String.FromInt(db.LastInsertId())

        var imported: int = 0
        var createdPlayers: int = 0
        let seen: List<string> = new List<string>()
        for i in 0..rowsV.Length() {
            let r: JsonValue = rowsV.At(i)
            if (!Fld.HasStr(r, "name")) { continue }
            let name: string = Fld.Str(r, "name")
            if (String.Length(name) == 0) { continue }
            var firstname: string = ""
            if (Fld.HasStr(r, "firstname")) { firstname = Fld.Str(r, "firstname") }
            var licence: string = ""
            if (Fld.HasStr(r, "licence")) { licence = Fld.Str(r, "licence") }
            if (licence == "0") { licence = "" }

            var pid: string = ""
            if (String.Length(licence) > 0) {
                let byLic: List<List<string>> = db.Rows("SELECT id FROM players WHERE licence = ?", Db.P1(licence))
                if (byLic.Count() > 0) { let l0: List<string> = byLic.Get(0) pid = l0.Get(0) }
            }
            if (String.Length(pid) == 0) {
                let byName: List<List<string>> = db.Rows("SELECT id FROM players WHERE is_relais = FALSE AND LOWER(name) = LOWER(?) AND LOWER(firstname) = LOWER(?) ORDER BY id ASC", Db.P2(name, firstname))
                if (byName.Count() > 0) { let n0: List<string> = byName.Get(0) pid = n0.Get(0) }
            }
            if (String.Length(pid) == 0) {
                var okP: bool = false
                if (String.Length(licence) > 0) {
                    okP = db.Exec("INSERT INTO players (licence, name, firstname) VALUES (?, ?, ?)", Db.P3(licence, name, firstname))
                } else {
                    okP = db.Exec("INSERT INTO players (name, firstname) VALUES (?, ?)", Db.P2(name, firstname))
                }
                if (!okP) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
                pid = String.FromInt(db.LastInsertId())
                createdPlayers = createdPlayers + 1
            }
            var dup: bool = false
            for sp in seen { if (sp == pid) { dup = true } }
            if (dup) { continue }
            seen.Add(pid)

            let ps: List<string> = new List<string>()
            ps.Add(subId)
            ps.Add(pid)
            ps.Add(Fld.NumOr(r, "points", "0"))
            ps.Add(Fld.NumOr(r, "points", "0"))
            ps.Add(Fld.IntOr(r, "place", "0"))
            ps.Add(Fld.NumOr(r, "pcn", "0"))
            let okR: bool = db.Exec("INSERT INTO rankings (sub_tournament_id, player_id, rounds_played, total, total_general, place, pcn, pp, eliminated) VALUES (?, ?, 0, ?, ?, ?, ?, 0, FALSE)", ps)
            if (!okR) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
            imported = imported + 1
        }
        if (imported == 0) { db.Rollback() return HttpErr.BadRequest("Aucune ligne exploitable (nom manquant)") }
        db.Commit()

        let o: JsonValue = J.Obj()
        o.AppendEntry("sub_tournament_id", J.CellInt(subId))
        o.AppendEntry("label", J.Str(label))
        o.AppendEntry("imported", J.Int(imported))
        o.AppendEntry("created_players", J.Int(createdPlayers))
        let resp: HttpResponse = J.Ok(o)
        return resp.Status(201)
    }

    // Raison pour laquelle un tournoi (soirée) n'est pas terminé, ou "" s'il
    // l'est. Terminé = toutes les manches prévues générées et toutes les
    // tables de toutes ses manches validées. Un tournoi importé (CSV d'un
    // classeur Excel) est terminé par nature.
    static string NotFinishedReason(Db db, List<string> srow) {
        if (Db.CellBool(srow.Get(2))) { return "" }
        let subId: string = srow.Get(0)
        var planned: int = Db.CellInt(srow.Get(3))
        if (planned < 1) { planned = 1 }
        let rr: List<List<string>> = db.Rows(
            "SELECT COUNT(DISTINCT r.id) FROM rounds r JOIN seats s ON s.round_id = r.id WHERE r.sub_tournament_id = ?",
            Db.P1(subId))
        let r0: List<string> = rr.Get(0)
        let generated: int = Db.CellInt(r0.Get(0))
        if (generated == 0) { return "pas encore joué" }
        let ur: List<List<string>> = db.Rows(
            "SELECT COUNT(*) FROM (SELECT s.round_id, s.table_number FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ? GROUP BY s.round_id, s.table_number) t LEFT JOIN table_results tr ON tr.round_id = t.round_id AND tr.table_number = t.table_number WHERE tr.id IS NULL OR tr.validated = FALSE",
            Db.P1(subId))
        let u0: List<string> = ur.Get(0)
        let unvalidated: int = Db.CellInt(u0.Get(0))
        var why: string = ""
        if (generated < planned) {
            why = String.FromInt(generated) + " manche(s) sur " + String.FromInt(planned) + " prévue(s)"
        }
        if (unvalidated > 0) {
            if (String.Length(why) > 0) { why = why + ", " }
            why = why + String.FromInt(unvalidated) + " table(s) non validée(s)"
        }
        return why
    }

    public static HttpResponse GetChallengeRanking(WebContext ctx, Db db) {
        let tid: string = ctx.Param("tournamentId")
        let trows: List<List<string>> = db.Rows("SELECT id, challenge_mode FROM tournaments WHERE id = ?", Db.P1(tid))
        if (trows.Count() == 0) { return HttpErr.NotFound() }
        let t0: List<string> = trows.Get(0)
        let mode: string = t0.Get(1)

        let allSubs: List<List<string>> = db.Rows("SELECT id, label, imported, rounds_planned FROM sub_tournaments WHERE tournament_id = ? ORDER BY id ASC", Db.P1(tid))

        // Seuls les tournois TERMINÉS comptent, et le classement s'arrête au
        // premier qui ne l'est pas (choix du club, 2026-11-25) : un tournoi
        // en cours, dont le classement se recalcule à chaque table validée,
        // ne fausse plus le Challenge, et un tournoi plus récent attend que
        // le précédent soit terminé. Les autres sont renvoyés dans
        // « pending », avec la raison, pour que l'écran l'explique.
        let subs: List<List<string>> = new List<List<string>>()
        let pendingArr: JsonValue = J.Arr()
        var blockedBy: string = ""
        for si in 0..allSubs.Count() {
            let srow: List<string> = allSubs.Get(si)
            let why: string = ModRanking.NotFinishedReason(db, srow)
            if (String.Length(blockedBy) == 0 && String.Length(why) == 0) {
                subs.Add(srow)
            } else {
                let po: JsonValue = J.Obj()
                po.AppendEntry("id", J.CellInt(srow.Get(0)))
                po.AppendEntry("label", J.CellStr(srow.Get(1)))
                if (String.Length(why) > 0) {
                    po.AppendEntry("reason", J.Str("non terminé : " + why))
                } else {
                    po.AppendEntry("reason", J.Str("terminé, compté quand « " + blockedBy + " » le sera"))
                }
                pendingArr.AppendItem(po)
                if (String.Length(blockedBy) == 0) { blockedBy = srow.Get(1) }
            }
        }

        let pointsByPlayer: Map<string, string> = new Map<string, string>()
        let rawByPlayer: Map<string, string> = new Map<string, string>()
        let pcnByPlayer: Map<string, string> = new Map<string, string>()
        let playedByPlayer: Map<string, int> = new Map<string, int>()
        let licenceByPlayer: Map<string, string> = new Map<string, string>()
        let nameByPlayer: Map<string, string> = new Map<string, string>()
        let firstnameByPlayer: Map<string, string> = new Map<string, string>()
        // Détail par tournoi (format Excel du club : Points / Pcn / PC par
        // colonne), clé "pid|subId" → "points|pcn|pc".
        let detail: Map<string, string> = new Map<string, string>()
        let playersBySub: Map<string, int> = new Map<string, int>()

        for si in 0..subs.Count() {
            let srow: List<string> = subs.Get(si)
            let subId: string = srow.Get(0)
            let rows: List<List<string>> = db.Rows(
                "SELECT r.player_id, p.licence, p.name, p.firstname, r.total_general, r.place, r.pcn FROM rankings r JOIN players p ON p.id = r.player_id WHERE r.sub_tournament_id = ? AND p.is_relais = FALSE ORDER BY r.place ASC", Db.P1(subId))
            let n: int = rows.Count()
            playersBySub.Set(subId, n)
            // Points Challenge : le 1er marque autant de points qu'il y a de
            // joueurs classés, le dernier 1 point. On se base sur le RANG dans
            // la liste triée, pas sur `rankings.place` : une place peut manquer
            // (ligne ignorée à l'import) ou dépasser le nombre de joueurs, ce
            // qui créait des trous dans les points (11, 10, 8…) et écrasait les
            // derniers à 1 point ex aequo (retour terrain n°8). Les joueurs à
            // la même place gardent le même nombre de points.
            var rank: int = 0
            var prevPlace: int = -1
            for i in 0..n {
                let row: List<string> = rows.Get(i)
                let pid: string = row.Get(0)
                let raw: float = Db.CellFloat(row.Get(4))
                let pcn: float = Db.CellFloat(row.Get(6))
                let place: int = Db.CellInt(row.Get(5))
                if (i == 0 || place != prevPlace) { rank = i + 1 }
                prevPlace = place
                var pts: float = 0.0
                if (mode == "raw") {
                    pts = raw
                } else {
                    var p: int = n - rank + 1
                    if (p < 1) { p = 1 }
                    pts = String.ToFloat(String.FromInt(p))
                }
                let cur: float = ModRanking.MapGetF(pointsByPlayer, pid)
                pointsByPlayer.Set(pid, String.FromFloat(cur + pts))
                rawByPlayer.Set(pid, String.FromFloat(ModRanking.MapGetF(rawByPlayer, pid) + raw))
                pcnByPlayer.Set(pid, String.FromFloat(ModRanking.MapGetF(pcnByPlayer, pid) + pcn))
                playedByPlayer.Set(pid, ModRanking.MapGetI(playedByPlayer, pid) + 1)
                licenceByPlayer.Set(pid, row.Get(1))
                nameByPlayer.Set(pid, row.Get(2))
                firstnameByPlayer.Set(pid, row.Get(3))
                detail.Set(pid + "|" + subId, String.FromFloat(raw) + "|" + String.FromFloat(pcn) + "|" + String.FromFloat(pts))
            }
        }

        let entries: List<ChallengeEntry> = new List<ChallengeEntry>()
        let ids: List<string> = pointsByPlayer.Keys()
        for i in 0..ids.Count() {
            let pid: string = ids.Get(i)
            let e: ChallengeEntry = new ChallengeEntry()
            e.PlayerId = Db.CellInt(pid)
            e.Licence = licenceByPlayer.Get(pid)
            e.Name = nameByPlayer.Get(pid)
            e.Firstname = firstnameByPlayer.Get(pid)
            e.Played = ModRanking.MapGetI(playedByPlayer, pid)
            e.Points = ModRanking.MapGetF(pointsByPlayer, pid)
            entries.Add(e)
        }

        ModRanking.SortDescChallenge(entries)
        var place: int = 1
        for i in 0..entries.Count() {
            let e: ChallengeEntry = entries.Get(i)
            if (i > 0) {
                let prev: ChallengeEntry = entries.Get(i - 1)
                if (e.Points < prev.Points) { place = i + 1 }
            }
            e.Place = place
        }

        let arr: JsonValue = J.Arr()
        for i in 0..entries.Count() {
            let e: ChallengeEntry = entries.Get(i)
            let pid: string = String.FromInt(e.PlayerId)
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.Int(e.PlayerId))
            o.AppendEntry("licence", J.CellStrN(e.Licence))
            o.AppendEntry("name", J.Str(e.Name))
            o.AppendEntry("firstname", J.Str(e.Firstname))
            o.AppendEntry("sub_tournaments_played", J.Int(e.Played))
            o.AppendEntry("points", J.Float(e.Points))
            o.AppendEntry("total_points", J.Float(ModRanking.MapGetF(rawByPlayer, pid)))
            o.AppendEntry("total_pcn", J.Float(ModRanking.MapGetF(pcnByPlayer, pid)))
            o.AppendEntry("place", J.Int(e.Place))
            // Une entrée par tournoi du challenge, null si le joueur n'y était pas.
            let det: JsonValue = J.Arr()
            for si in 0..subs.Count() {
                let srow: List<string> = subs.Get(si)
                let key: string = pid + "|" + srow.Get(0)
                if (detail.Has(key)) {
                    let parts: List<string> = String.Split(detail.Get(key), "|")
                    let d: JsonValue = J.Obj()
                    d.AppendEntry("points", J.Float(String.ToFloat(parts.Get(0))))
                    d.AppendEntry("pcn", J.Float(String.ToFloat(parts.Get(1))))
                    d.AppendEntry("pc", J.Float(String.ToFloat(parts.Get(2))))
                    det.AppendItem(d)
                } else {
                    det.AppendItem(J.Null())
                }
            }
            o.AppendEntry("details", det)
            arr.AppendItem(o)
        }
        let subsArr: JsonValue = J.Arr()
        for si in 0..subs.Count() {
            let srow: List<string> = subs.Get(si)
            let so: JsonValue = J.Obj()
            so.AppendEntry("id", J.CellInt(srow.Get(0)))
            so.AppendEntry("label", J.CellStr(srow.Get(1)))
            so.AppendEntry("imported", J.CellBool(srow.Get(2)))
            so.AppendEntry("players", J.Int(ModRanking.MapGetI(playersBySub, srow.Get(0))))
            subsArr.AppendItem(so)
        }
        let result: JsonValue = J.Obj()
        result.AppendEntry("challenge_mode", J.Str(mode))
        result.AppendEntry("sub_tournaments_count", J.Int(subs.Count()))
        result.AppendEntry("sub_tournaments", subsArr)
        result.AppendEntry("pending", pendingArr)
        result.AppendEntry("ranking", arr)
        return J.Ok(result)
    }

    // POST /api/sub-tournaments/:subTournamentId/recompute (admin)
    public static HttpResponse Recompute(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }
        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }
        ModRanking.RefreshAndBroadcast(db, subId)
        return ModRanking.GetRanking(ctx, db)
    }

    // GET /api/sub-tournaments/:subTournamentId/export-pcn.csv
    public static HttpResponse ExportPcn(WebContext ctx, Db db) {
        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows(
            "SELECT st.id, st.label, st.indice_pcn, t.code, t.name FROM sub_tournaments st JOIN tournaments t ON t.id = st.tournament_id WHERE st.id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }
        let s0: List<string> = subt.Get(0)
        let label: string = s0.Get(1)
        let indicePcn: string = s0.Get(2)
        let code: string = s0.Get(3)
        let tname: string = s0.Get(4)

        let rows: List<List<string>> = db.Rows(
            "SELECT r.pcn, r.pp, p.licence, p.name, p.firstname FROM rankings r JOIN players p ON p.id = r.player_id WHERE r.sub_tournament_id = ? AND r.pcn > 0 AND p.is_relais = FALSE ORDER BY r.pcn DESC", Db.P1(subId))

        var indPcnInt: string = "0"
        if (String.Length(indicePcn) > 0) { indPcnInt = String.FromInt(Db.CellInt(indicePcn)) }
        // En-tête du masque (feuille « Masque » du classeur de challenge) : nom et prénom en DEUX colonnes distinctes. L'export les
        // fusionnait, ce que le masque ne sait pas relire.
        var csv: string = code + ";" + String.FromInt(rows.Count()) + ";" + indPcnInt + ";1\n"
        csv = csv + tname + " - " + label + "\n"
        csv = csv + "NumLicenceJoueur;NomJoueur;PrenomJoueur;Pcn;Pp\n"
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            csv = csv + r.Get(2) + ";" + r.Get(3) + ";" + r.Get(4) + ";" + String.FromInt(Db.CellInt(r.Get(0))) + ";" + String.FromInt(Db.CellInt(r.Get(1))) + "\n"
        }
        var fname: string = code
        if (String.Length(fname) == 0) { fname = "tournoi" }
        return HttpResponse.New().Status(200).Header("Content-Type", "text/csv; charset=utf-8").Header("Content-Disposition", "attachment; filename=\"" + fname + "-" + label + ".csv\"").Text(csv)
    }
