namespace App

import Amalgame.Web
import Amalgame.Json

// Module players — CRUD + recherche (search/club_id/licence), LEFT JOIN clubs.
public class ModPlayers {

    static string SELECT_BASE() {
        return "SELECT p.id, p.licence, p.name, p.firstname, p.club_id, p.category, p.gender, p.birth_year, p.created_at, c.code AS club_code, c.name AS club_name, p.club_member FROM players p LEFT JOIN clubs c ON c.id = p.club_id"
    }

    public static JsonValue Row(List<string> r) {
        let o: JsonValue = J.Obj()
        o.AppendEntry("id", J.CellInt(r.Get(0)))
        o.AppendEntry("licence", J.CellStrN(r.Get(1)))
        o.AppendEntry("name", J.CellStr(r.Get(2)))
        o.AppendEntry("firstname", J.CellStr(r.Get(3)))
        o.AppendEntry("club_id", J.CellIntN(r.Get(4)))
        o.AppendEntry("category", J.CellStrN(r.Get(5)))
        o.AppendEntry("gender", J.CellStrN(r.Get(6)))
        o.AppendEntry("birth_year", J.CellIntN(r.Get(7)))
        o.AppendEntry("created_at", J.CellStrN(r.Get(8)))
        o.AppendEntry("club_code", J.CellStrN(r.Get(9)))
        o.AppendEntry("club_name", J.CellStrN(r.Get(10)))
        o.AppendEntry("club_member", J.CellBool(r.Get(11)))
        return o
    }

    public static HttpResponse List(WebContext ctx, Db db) {
        let licence: string = ctx.QueryParam("licence")
        let clubId: string = ctx.QueryParam("club_id")
        let search: string = ctx.QueryParam("search")
        let member: string = ctx.QueryParam("club_member")

        let conds: List<string> = new List<string>()
        let params: List<string> = new List<string>()
        if (String.Length(licence) > 0) {
            conds.Add("p.licence = ?")
            params.Add(licence)
        }
        if (String.Length(clubId) > 0) {
            conds.Add("p.club_id = ?")
            params.Add(clubId)
        }
        if (member == "1" || member == "true") {
            conds.Add("p.club_member = TRUE")
        }
        if (String.Length(search) > 0) {
            conds.Add("(p.name LIKE ? OR p.firstname LIKE ? OR p.licence LIKE ?)")
            let term: string = "%" + search + "%"
            params.Add(term)
            params.Add(term)
            params.Add(term)
        }

        var sql: string = ModPlayers.SELECT_BASE()
        if (conds.Count() > 0) {
            sql = sql + " WHERE " + String.Join(conds, " AND ")
        }
        sql = sql + " ORDER BY p.name ASC, p.firstname ASC"

        let rows: List<List<string>> = db.Rows(sql, params)
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            arr.AppendItem(ModPlayers.Row(r))
        }
        return J.Ok(arr)
    }

    public static HttpResponse GetById(WebContext ctx, Db db) {
        let id: string = ctx.Param("id")
        let rows: List<List<string>> = db.Rows(ModPlayers.SELECT_BASE() + " WHERE p.id = ?", Db.P1(id))
        if (rows.Count() == 0) { return HttpErr.NotFound() }
        let r0: List<string> = rows.Get(0)
        return J.Ok(ModPlayers.Row(r0))
    }

    static HttpResponse Refetch(Db db, int id) {
        let rows: List<List<string>> = db.Rows(ModPlayers.SELECT_BASE() + " WHERE p.id = ?", Db.P1(String.FromInt(id)))
        let r0: List<string> = rows.Get(0)
        return J.Ok(ModPlayers.Row(r0))
    }

    // Remplit un builder INSERT/UPDATE-like via callbacks Set/SetNull.
    // name/firstname requis ; le reste nullable (sémantique || null / ?? null).
    public static HttpResponse Create(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        if (!Fld.HasStr(b, "name")) { return HttpErr.BadRequest("name requis") }
        if (!Fld.HasStr(b, "firstname")) { return HttpErr.BadRequest("firstname requis") }

        let ins: SqlIns = new SqlIns()
        if (Fld.HasStr(b, "licence")) { ins.Set("licence", Fld.Str(b, "licence")) } else { ins.SetNull("licence") }
        ins.Set("name", Fld.Str(b, "name"))
        ins.Set("firstname", Fld.Str(b, "firstname"))
        if (Fld.HasInt(b, "club_id")) { ins.Set("club_id", Fld.IntStr(b, "club_id")) } else { ins.SetNull("club_id") }
        if (Fld.HasStr(b, "category")) { ins.Set("category", Fld.Str(b, "category")) } else { ins.SetNull("category") }
        if (Fld.HasStr(b, "gender")) { ins.Set("gender", Fld.Str(b, "gender")) } else { ins.SetNull("gender") }
        if (Fld.HasInt(b, "birth_year")) { ins.Set("birth_year", Fld.IntStr(b, "birth_year")) } else { ins.SetNull("birth_year") }
        ins.Set("club_member", Fld.BoolTo01(b, "club_member"))

        let ok: bool = db.Exec(ins.Sql("players"), ins.Params())
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        let resp: HttpResponse = ModPlayers.Refetch(db, db.LastInsertId())
        return resp.Status(201)
    }

    public static HttpResponse Update(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        if (!Fld.HasStr(b, "name")) { return HttpErr.BadRequest("name requis") }
        if (!Fld.HasStr(b, "firstname")) { return HttpErr.BadRequest("firstname requis") }

        let upd: SqlUpd = new SqlUpd()
        if (Fld.HasStr(b, "licence")) { upd.Set("licence", Fld.Str(b, "licence")) } else { upd.SetNull("licence") }
        upd.Set("name", Fld.Str(b, "name"))
        upd.Set("firstname", Fld.Str(b, "firstname"))
        if (Fld.HasInt(b, "club_id")) { upd.Set("club_id", Fld.IntStr(b, "club_id")) } else { upd.SetNull("club_id") }
        if (Fld.HasStr(b, "category")) { upd.Set("category", Fld.Str(b, "category")) } else { upd.SetNull("category") }
        if (Fld.HasStr(b, "gender")) { upd.Set("gender", Fld.Str(b, "gender")) } else { upd.SetNull("gender") }
        if (Fld.HasInt(b, "birth_year")) { upd.Set("birth_year", Fld.IntStr(b, "birth_year")) } else { upd.SetNull("birth_year") }
        upd.Set("club_member", Fld.BoolTo01(b, "club_member"))

        let ok: bool = db.Exec(upd.Sql("players"), upd.ParamsWithId(id))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        if (db.Changes() == 0) { return HttpErr.NotFound() }
        return ModPlayers.Refetch(db, String.ToInt(id))
    }

    // POST /api/players/import (admin)
    // Import en masse (liste club). Upsert par licence quand fournie : crée
    // si absente, met à jour nom/prénom si la licence existe déjà et diffère.
    // Sans licence, création simple. Ne fusionne jamais automatiquement deux
    // joueurs différents : un même nom+prénom déjà en base (licence
    // différente ou absente) est seulement signalé en "doublon potentiel"
    // dans la réponse, à vérifier manuellement.
    public static HttpResponse Import(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        let playersV: JsonValue = b.Get("players")
        if (!playersV.IsArray()) { return HttpErr.BadRequest("players doit être un tableau") }
        let n: int = playersV.Length()

        var created: int = 0
        var updated: int = 0
        var unchanged: int = 0
        let dupWarnings: JsonValue = J.Arr()

        db.Begin()
        for i in 0..n {
            let p: JsonValue = playersV.At(i)
            if (!Fld.HasStr(p, "name")) { continue }
            let name: string = Fld.Str(p, "name")
            var firstname: string = ""
            if (Fld.HasStr(p, "firstname")) { firstname = Fld.Str(p, "firstname") }
            var licence: string = ""
            var hasLicence: bool = false
            if (Fld.HasStr(p, "licence")) { licence = Fld.Str(p, "licence") hasLicence = true }

            if (hasLicence) {
                let existing: List<List<string>> = db.Rows("SELECT id, name, firstname FROM players WHERE licence = ?", Db.P1(licence))
                if (existing.Count() > 0) {
                    let e0: List<string> = existing.Get(0)
                    let pid: string = e0.Get(0)
                    if (e0.Get(1) == name && e0.Get(2) == firstname) {
                        unchanged = unchanged + 1
                    } else {
                        let updOk: bool = db.Exec("UPDATE players SET name = ?, firstname = ? WHERE id = ?", Db.P3(name, firstname, pid))
                        if (!updOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
                        updated = updated + 1
                    }
                    continue
                }
            }

            // Doublon potentiel : même nom+prénom déjà en base (licence différente ou absente).
            let dupRows: List<List<string>> = db.Rows("SELECT licence FROM players WHERE name = ? AND firstname = ?", Db.P2(name, firstname))
            if (dupRows.Count() > 0) {
                let dw: JsonValue = J.Obj()
                dw.AppendEntry("name", J.Str(name))
                dw.AppendEntry("firstname", J.Str(firstname))
                if (hasLicence) { dw.AppendEntry("new_licence", J.Str(licence)) } else { dw.AppendEntry("new_licence", J.Null()) }
                dupWarnings.AppendItem(dw)
            }

            let ins: SqlIns = new SqlIns()
            if (hasLicence && String.Length(licence) > 0) { ins.Set("licence", licence) } else { ins.SetNull("licence") }
            ins.Set("name", name)
            ins.Set("firstname", firstname)
            ins.SetNull("club_id")
            ins.SetNull("category")
            ins.SetNull("gender")
            ins.SetNull("birth_year")
            ins.Set("club_member", Fld.BoolTo01(p, "club_member"))
            let ok: bool = db.Exec(ins.Sql("players"), ins.Params())
            if (!ok) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
            created = created + 1
        }
        db.Commit()

        let result: JsonValue = J.Obj()
        result.AppendEntry("created", J.Int(created))
        result.AppendEntry("updated", J.Int(updated))
        result.AppendEntry("unchanged", J.Int(unchanged))
        result.AppendEntry("potential_duplicates", dupWarnings)
        return J.Ok(result)
    }

    public static HttpResponse Remove(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let ok: bool = db.Exec("DELETE FROM players WHERE id = ?", Db.P1(id))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        if (db.Changes() == 0) { return HttpErr.NotFound() }
        return J.NoContent()
    }
}
