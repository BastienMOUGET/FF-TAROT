namespace App

import Amalgame.Web
import Amalgame.Json

// Module teams — équipes Libre par 4 (2 paires NS + 2 paires EO).
public class ModTeams {

    // Joueurs d'une équipe → tableau JSON (jointure team_players + players).
    static JsonValue PlayersJson(Db db, string teamId) {
        let rows: List<List<string>> = db.Rows(
            "SELECT tp.player_id, tp.pair, tp.player_number, p.licence, p.name, p.firstname, p.club_id, p.category, tp.seat, tp.orientation FROM team_players tp JOIN players p ON p.id = tp.player_id WHERE tp.team_id = ? ORDER BY tp.player_number",
            Db.P1(teamId))
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            let o: JsonValue = J.Obj()
            o.AppendEntry("player_id", J.CellInt(r.Get(0)))
            o.AppendEntry("pair", J.CellStr(r.Get(1)))
            o.AppendEntry("player_number", J.CellInt(r.Get(2)))
            o.AppendEntry("seat", J.CellStrN(r.Get(8)))
            o.AppendEntry("orientation", J.CellStrN(r.Get(9)))
            o.AppendEntry("licence", J.CellStrN(r.Get(3)))
            o.AppendEntry("name", J.CellStr(r.Get(4)))
            o.AppendEntry("firstname", J.CellStr(r.Get(5)))
            o.AppendEntry("club_id", J.CellIntN(r.Get(6)))
            o.AppendEntry("category", J.CellStrN(r.Get(7)))
            arr.AppendItem(o)
        }
        return arr
    }

    static JsonValue TeamJson(Db db, List<string> teamRow) {
        let o: JsonValue = J.Obj()
        let id: string = teamRow.Get(0)
        o.AppendEntry("id", J.CellInt(id))
        o.AppendEntry("sub_tournament_id", J.CellInt(teamRow.Get(1)))
        o.AppendEntry("team_number", J.CellInt(teamRow.Get(2)))
        o.AppendEntry("players", ModTeams.PlayersJson(db, id))
        return o
    }

    // GET /api/sub-tournaments/:subTournamentId/teams
    public static HttpResponse ListBySubTournament(WebContext ctx, Db db) {
        let subId: string = ctx.Param("subTournamentId")
        let rows: List<List<string>> = db.Rows(
            "SELECT id, sub_tournament_id, team_number FROM teams WHERE sub_tournament_id = ? ORDER BY team_number ASC",
            Db.P1(subId))
        let arr: JsonValue = J.Arr()
        for i in 0..rows.Count() {
            let r: List<string> = rows.Get(i)
            arr.AppendItem(ModTeams.TeamJson(db, r))
        }
        return J.Ok(arr)
    }

    // GET /api/teams/:id
    public static HttpResponse GetById(WebContext ctx, Db db) {
        let id: string = ctx.Param("id")
        let rows: List<List<string>> = db.Rows(
            "SELECT id, sub_tournament_id, team_number FROM teams WHERE id = ?", Db.P1(id))
        if (rows.Count() == 0) { return HttpErr.NotFound() }
        let r0: List<string> = rows.Get(0)
        return J.Ok(ModTeams.TeamJson(db, r0))
    }

    // POST /api/sub-tournaments/:subTournamentId/teams (admin)
    public static HttpResponse Create(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let subId: string = ctx.Param("subTournamentId")
        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        let playersV: JsonValue = b.Get("players")
        if (!playersV.IsArray()) { return HttpErr.BadRequest("players doit être un tableau") }
        let n: int = playersV.Length()
        if (n != 3 && n != 4) { return HttpErr.BadRequest("Une équipe doit contenir 3 ou 4 joueurs") }

        // Validation NS / EO + pas de doublon ; collecte ordonnée NS puis EO.
        let nsIds: List<string> = new List<string>()
        let eoIds: List<string> = new List<string>()
        // Siège explicite (optionnel) par joueur, aligné sur nsIds puis eoIds.
        // "" = non fourni : la mise en place retombe sur l'ordre des joueurs.
        let nsSeats: List<string> = new List<string>()
        let eoSeats: List<string> = new List<string>()
        // Consigne de position du tirage (migration 011), alignée de même.
        // "" = aléatoire.
        let nsOrients: List<string> = new List<string>()
        let eoOrients: List<string> = new List<string>()
        let seen: List<string> = new List<string>()
        let seenSeats: List<string> = new List<string>()
        for i in 0..n {
            let p: JsonValue = playersV.At(i)
            let pidV: JsonValue = p.Get("player_id")
            let pairV: JsonValue = p.Get("pair")
            if (!pidV.IsInt()) { return HttpErr.BadRequest("player_id entier requis") }
            if (!pairV.IsString()) { return HttpErr.BadRequest("pair requis") }
            let pid: string = String.FromInt(pidV.AsInt())
            let pair: string = pairV.AsString()
            for s in seen { if (s == pid) { return HttpErr.BadRequest("Doublon de joueur dans l'équipe") } }
            seen.Add(pid)
            var seat: string = ""
            if (Fld.HasStr(p, "seat")) {
                seat = Fld.Str(p, "seat")
                if (seat != "N" && seat != "S" && seat != "E" && seat != "O") { return HttpErr.BadRequest("seat doit être N, S, E ou O") }
                for ss in seenSeats { if (ss == seat) { return HttpErr.BadRequest("Deux joueurs sur le même siège (" + seat + ")") } }
                seenSeats.Add(seat)
                // Cohérence paire/siège : N et S sont la paire NS, E et O la paire EO.
                if ((seat == "N" || seat == "S") && pair != "NS") { return HttpErr.BadRequest("Le siège " + seat + " appartient à la paire NS") }
                if ((seat == "E" || seat == "O") && pair != "EO") { return HttpErr.BadRequest("Le siège " + seat + " appartient à la paire EO") }
            }
            var orient: string = ""
            if (Fld.HasStr(p, "orientation")) {
                orient = Fld.Str(p, "orientation")
                if (orient != "N" && orient != "S" && orient != "E" && orient != "O" && orient != "not_north") { return HttpErr.BadRequest("orientation doit être N, S, E, O ou not_north") }
            }
            if (pair == "NS") { nsIds.Add(pid) nsSeats.Add(seat) nsOrients.Add(orient) }
            else { if (pair == "EO") { eoIds.Add(pid) eoSeats.Add(seat) eoOrients.Add(orient) } else { return HttpErr.BadRequest("pair doit être NS ou EO") } }
        }
        if (n == 4) {
            if (nsIds.Count() != 2 || eoIds.Count() != 2) { return HttpErr.BadRequest("Une équipe de 4 doit avoir exactement 2 joueurs NS et 2 joueurs EO") }
        } else {
            if (nsIds.Count() == 0 || eoIds.Count() == 0) { return HttpErr.BadRequest("Une équipe de 3 doit avoir au moins 1 joueur de chaque côté (NS/EO)") }
        }

        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }

        db.Begin()
        let numRows: List<List<string>> = db.Rows(
            "SELECT COALESCE(MAX(team_number), 0) + 1 AS n FROM teams WHERE sub_tournament_id = ?", Db.P1(subId))
        let nr0: List<string> = numRows.Get(0)
        let teamNumber: int = Db.CellInt(nr0.Get(0))

        let insOk: bool = db.Exec("INSERT INTO teams (sub_tournament_id, team_number) VALUES (?, ?)", Db.P2(subId, String.FromInt(teamNumber)))
        if (!insOk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        let teamId: int = db.LastInsertId()
        let teamIdS: string = String.FromInt(teamId)

        // NS d'abord (player_number 1,2) puis EO (3,4)
        var num: int = 1
        for k in 0..nsIds.Count() {
            if (!ModTeams.InsTp(db, teamIdS, nsIds.Get(k), "NS", num, nsSeats.Get(k), nsOrients.Get(k))) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
            num = num + 1
        }
        for k in 0..eoIds.Count() {
            if (!ModTeams.InsTp(db, teamIdS, eoIds.Get(k), "EO", num, eoSeats.Get(k), eoOrients.Get(k))) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
            num = num + 1
        }
        db.Commit()

        let rows: List<List<string>> = db.Rows("SELECT id, sub_tournament_id, team_number FROM teams WHERE id = ?", Db.P1(teamIdS))
        let r0: List<string> = rows.Get(0)
        let resp: HttpResponse = J.Ok(ModTeams.TeamJson(db, r0))
        return resp.Status(201)
    }

    // `seat` et `orient` : "" = non fourni (NULL en base).
    static bool InsTp(Db db, string teamId, string playerId, string pair, int num, string seat, string orient) {
        let ps: List<string> = new List<string>()
        ps.Add(teamId)
        ps.Add(playerId)
        ps.Add(pair)
        ps.Add(String.FromInt(num))
        var seatSql: string = "NULL"
        if (String.Length(seat) > 0) { seatSql = "?" ps.Add(seat) }
        var orientSql: string = "NULL"
        if (String.Length(orient) > 0) { orientSql = "?" ps.Add(orient) }
        return db.Exec("INSERT INTO team_players (team_id, player_id, pair, player_number, seat, orientation) VALUES (?, ?, ?, ?, " + seatSql + ", " + orientSql + ")", ps)
    }

    // POST /api/sub-tournaments/:subTournamentId/substitute (admin)
    // Remplace un joueur par un autre dans TOUT le tournoi : inscription,
    // places de chaque manche, classements. Répare le cas courant d'une
    // case cochée à côté de la bonne au pointage des présents — les points
    // déjà saisis suivent le joueur qui était réellement à la table, sans
    // rien resaisir (retour terrain n°10).
    // Corps : { from_player_id, to_player_id }.
    public static HttpResponse Substitute(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let subId: string = ctx.Param("subTournamentId")
        let subt: List<List<string>> = db.Rows("SELECT id FROM sub_tournaments WHERE id = ?", Db.P1(subId))
        if (subt.Count() == 0) { return HttpErr.NotFound() }

        let pr: JsonResult = Json.Parse(ctx.Body)
        if (!pr.Ok) { return HttpErr.BadRequest("JSON invalide") }
        let b: JsonValue = pr.Value
        if (!Fld.HasInt(b, "from_player_id")) { return HttpErr.BadRequest("from_player_id requis") }
        if (!Fld.HasInt(b, "to_player_id")) { return HttpErr.BadRequest("to_player_id requis") }
        let fromId: string = Fld.IntStr(b, "from_player_id")
        let toId: string = Fld.IntStr(b, "to_player_id")
        if (fromId == toId) { return HttpErr.BadRequest("Les deux joueurs sont les mêmes") }

        // Les deux joueurs doivent exister et ne pas être des Relais : un
        // Relais n'est pas une personne, il ne se remplace pas.
        let fr: List<List<string>> = db.Rows("SELECT name, firstname, is_relais FROM players WHERE id = ?", Db.P1(fromId))
        if (fr.Count() == 0) { return HttpErr.BadRequest("Joueur à remplacer introuvable") }
        let f0: List<string> = fr.Get(0)
        // Un Relais PEUT céder sa place : c'est ainsi qu'un joueur oublié au
        // pointage rejoint une table de 3 sans refaire tout le placement
        // (retour terrain n°13). La table passe alors de 3 à 4 joueurs.
        let fromRelais: bool = Db.CellBool(f0.Get(2))
        let tr: List<List<string>> = db.Rows("SELECT name, firstname, is_relais FROM players WHERE id = ?", Db.P1(toId))
        if (tr.Count() == 0) { return HttpErr.BadRequest("Joueur remplaçant introuvable") }
        let t0: List<string> = tr.Get(0)
        if (Db.CellBool(t0.Get(2))) { return HttpErr.BadRequest("Un Relais ne peut pas remplacer un joueur") }
        if (fromId == toId) { return HttpErr.BadRequest("Les deux joueurs sont les mêmes") }

        // Un Relais n'est pas « inscrit » (il n'a pas d'équipe) : on vérifie
        // alors qu'il occupe bien une place dans une manche du tournoi.
        if (fromRelais) {
            let seated: List<List<string>> = db.Rows(
                "SELECT COUNT(*) FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ? AND s.player_id = ?",
                Db.P2(subId, fromId))
            let s0: List<string> = seated.Get(0)
            if (Db.CellInt(s0.Get(0)) == 0) { return HttpErr.BadRequest("Ce Relais ne joue pas dans ce tournoi") }
        } else {
            let inscr: List<List<string>> = db.Rows(
                "SELECT COUNT(*) FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ? AND tp.player_id = ?",
                Db.P2(subId, fromId))
            let i0: List<string> = inscr.Get(0)
            if (Db.CellInt(i0.Get(0)) == 0) { return HttpErr.BadRequest(f0.Get(1) + " " + f0.Get(0) + " n'est pas inscrit dans ce tournoi") }
        }

        let already: List<List<string>> = db.Rows(
            "SELECT COUNT(*) FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ? AND tp.player_id = ?",
            Db.P2(subId, toId))
        let a0: List<string> = already.Get(0)
        if (Db.CellInt(a0.Get(0)) > 0) { return HttpErr.BadRequest(t0.Get(1) + " " + t0.Get(0) + " est déjà inscrit dans ce tournoi : il jouerait deux fois") }

        // La garde ci-dessus compare des IDENTIFIANTS. Le 30/09, deux fiches
        // existaient pour la meme personne (« MAZIMANN AURELIEN » et
        // « MAZIMANN Aurélien ») : les ids differaient, le controle a laisse
        // passer, et le joueur s'est retrouve assis a deux tables, bloquant le
        // demarrage du tournoi. On compare donc aussi les NOMS — la collation
        // de la base ignore casse et accents (retour terrain n°18).
        let homonyme: List<List<string>> = db.Rows(
            "SELECT p.id, p.name, p.firstname FROM players p WHERE p.name = ? AND p.firstname = ? AND p.id <> ? AND p.id IN (SELECT tp.player_id FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ? UNION SELECT s.player_id FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ?)",
            Db.P5(t0.Get(0), t0.Get(1), toId, subId, subId))
        if (homonyme.Count() > 0) {
            let h0: List<string> = homonyme.Get(0)
            return HttpErr.BadRequest(h0.Get(1) + " " + h0.Get(2) + " joue deja dans ce tournoi, sous une autre fiche (n°" + h0.Get(0) + " contre n°" + toId + "). Il s'agit vraisemblablement de deux fiches pour la meme personne : corrigez le doublon dans Administration > Joueurs avant de continuer.")
        }

        db.Begin()
        // Remplacer un Relais : le nouveau joueur prend sa place ET rejoint
        // l'équipe de la table, qui passe de 3 à 4 joueurs.
        if (fromRelais) {
            // L'équipe visée est celle des voisins de table à la PREMIÈRE
            // manche : après le mouvement, les voisins changent et on
            // rattacherait le joueur à une équipe au hasard.
            let teamRows: List<List<string>> = db.Rows(
                "SELECT DISTINCT tp.team_id FROM seats s JOIN rounds r ON r.id = s.round_id JOIN seats s2 ON s2.round_id = s.round_id AND s2.table_number = s.table_number JOIN team_players tp ON tp.player_id = s2.player_id JOIN teams t ON t.id = tp.team_id AND t.sub_tournament_id = r.sub_tournament_id WHERE r.sub_tournament_id = ? AND s.player_id = ? ORDER BY r.round_number ASC LIMIT 1",
                Db.P2(subId, fromId))
            if (teamRows.Count() > 0) {
                let t0r: List<string> = teamRows.Get(0)
                let numRows: List<List<string>> = db.Rows(
                    "SELECT COALESCE(MAX(player_number), 0) + 1 FROM team_players WHERE team_id = ?", Db.P1(t0r.Get(0)))
                let n0: List<string> = numRows.Get(0)
                let okAdd: bool = db.Exec(
                    "INSERT INTO team_players (team_id, player_id, pair, player_number, seat) VALUES (?, ?, 'NS', ?, 'N')",
                    Db.P3(t0r.Get(0), toId, n0.Get(0)))
                if (!okAdd) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
            }
        } else {
            let okTp: bool = db.Exec(
                "UPDATE team_players tp JOIN teams t ON t.id = tp.team_id SET tp.player_id = ? WHERE t.sub_tournament_id = ? AND tp.player_id = ?",
                Db.P3(toId, subId, fromId))
            if (!okTp) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        }
        let okSeats: bool = db.Exec(
            "UPDATE seats s JOIN rounds r ON r.id = s.round_id SET s.player_id = ? WHERE r.sub_tournament_id = ? AND s.player_id = ?",
            Db.P3(toId, subId, fromId))
        if (!okSeats) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        let seatsChanged: int = db.Changes()
        // Les lignes de classement des deux joueurs sont refaites par le
        // recalcul (contrainte d'unicité sub_tournament + joueur).
        let okRk: bool = db.Exec(
            "DELETE FROM rankings WHERE sub_tournament_id = ? AND player_id IN (?, ?)",
            Db.P3(subId, fromId, toId))
        if (!okRk) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        db.Commit()

        ModRanking.RefreshAndBroadcast(db, subId)

        let o: JsonValue = J.Obj()
        o.AppendEntry("from", J.Str(f0.Get(1) + " " + f0.Get(0)))
        o.AppendEntry("to", J.Str(t0.Get(1) + " " + t0.Get(0)))
        o.AppendEntry("seats_changed", J.Int(seatsChanged))
        return J.Ok(o)
    }

    // DELETE /api/teams/:id (admin)
    public static HttpResponse Remove(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let id: string = ctx.Param("id")
        let ok: bool = db.Exec("DELETE FROM teams WHERE id = ?", Db.P1(id))
        if (!ok) { return HttpErr.FromDb(db.LastError()) }
        if (db.Changes() == 0) { return HttpErr.NotFound() }
        return J.NoContent()
    }

    // Ids des Relais libres de la manche `roundId` (aucune place occupee).
    static int FreeRelais(Db db, string roundId) {
        let rows: List<List<string>> = db.Rows(
            "SELECT p.id FROM players p WHERE p.is_relais = TRUE AND p.id NOT IN (SELECT s.player_id FROM seats s WHERE s.round_id = ?) ORDER BY CAST(p.firstname AS UNSIGNED) ASC, p.id ASC LIMIT 1",
            Db.P1(roundId))
        if (rows.Count() == 0) { return -1 }
        let r0: List<string> = rows.Get(0)
        return Db.CellInt(r0.Get(0))
    }

    // DELETE /api/sub-tournaments/:subTournamentId/players/:playerId (admin)
    // Retire un joueur DEJA PLACE : un Relais reprend sa place a chaque
    // manche, la table passe de 4 a 3. C'est l'exact inverse de Substitute,
    // et le moyen de se sortir d'un placement errone sans tout refaire
    // (retour terrain n°18).
    public static HttpResponse RemovePlacedPlayer(WebContext ctx, Db db) {
        let rc: int = Auth.CheckRole(ctx, "admin")
        if (rc == 401) { return HttpErr.Unauthorized() }
        if (rc == 403) { return HttpErr.Forbidden() }

        let subId: string = ctx.Param("subTournamentId")
        let playerId: string = ctx.Param("playerId")

        let pr: List<List<string>> = db.Rows("SELECT name, firstname, is_relais FROM players WHERE id = ?", Db.P1(playerId))
        if (pr.Count() == 0) { return HttpErr.NotFound() }
        let p0: List<string> = pr.Get(0)
        if (Db.CellBool(p0.Get(2))) { return HttpErr.BadRequest("Un Relais n'est pas un joueur : il ne se retire pas.") }
        let who: string = p0.Get(1) + " " + p0.Get(0)

        // Un score deja valide sur une table ou il est assis : le retirer
        // fausserait un resultat acquis.
        let scored: List<List<string>> = db.Rows(
            "SELECT COUNT(*) FROM seats s JOIN rounds r ON r.id = s.round_id JOIN table_results tr ON tr.round_id = s.round_id AND tr.table_number = s.table_number WHERE r.sub_tournament_id = ? AND s.player_id = ? AND tr.validated = TRUE",
            Db.P2(subId, playerId))
        let sc0: List<string> = scored.Get(0)
        if (Db.CellInt(sc0.Get(0)) > 0) {
            return HttpErr.BadRequest(who + " a deja une table validee : retirer un joueur fausserait un resultat acquis. Annulez d'abord la validation de cette table.")
        }

        // Places occupees, manche par manche.
        let seats: List<List<string>> = db.Rows(
            "SELECT s.id, s.round_id, s.table_number FROM seats s JOIN rounds r ON r.id = s.round_id WHERE r.sub_tournament_id = ? AND s.player_id = ? ORDER BY r.round_number ASC",
            Db.P2(subId, playerId))

        // Une table deja a 3 (donc avec un Relais) tomberait a 2 joueurs
        // reels : le tarot ne se joue pas a deux, on refuse.
        for i in 0..seats.Count() {
            let st: List<string> = seats.Get(i)
            let hasRelais: List<List<string>> = db.Rows(
                "SELECT COUNT(*) FROM seats s JOIN players p ON p.id = s.player_id WHERE s.round_id = ? AND s.table_number = ? AND p.is_relais = TRUE",
                Db.P2(st.Get(1), st.Get(2)))
            let h0: List<string> = hasRelais.Get(0)
            if (Db.CellInt(h0.Get(0)) > 0) {
                return HttpErr.BadRequest(who + " est a une table de 3, deja completee par un Relais : la retirer la laisserait a deux joueurs. Refaites le tirage des places.")
            }
        }

        db.Begin()
        for i in 0..seats.Count() {
            let st: List<string> = seats.Get(i)
            let relais: int = ModTeams.FreeRelais(db, st.Get(1))
            if (relais < 0) {
                db.Rollback()
                return HttpErr.BadRequest("Plus aucun Relais disponible sur cette manche. Refaites le tirage des places.")
            }
            let ok: bool = db.Exec("UPDATE seats SET player_id = ? WHERE id = ?", Db.P2(String.FromInt(relais), st.Get(0)))
            if (!ok) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        }

        let ok2: bool = db.Exec(
            "DELETE tp FROM team_players tp JOIN teams t ON t.id = tp.team_id WHERE t.sub_tournament_id = ? AND tp.player_id = ?",
            Db.P2(subId, playerId))
        if (!ok2) { db.Rollback() return HttpErr.FromDb(db.LastError()) }
        db.Commit()

        let o: JsonValue = J.Obj()
        o.AppendEntry("removed", J.Bool(true))
        o.AppendEntry("player", J.Str(who))
        o.AppendEntry("rounds", J.Int(seats.Count()))
        return J.Ok(o)
    }
}
